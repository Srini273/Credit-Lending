<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>AI Credit Intelligence Platform v4.0 | Banking Risk Suite</title>
<meta name="description" content="Production-grade AI-powered credit risk analysis platform with OCR document extraction, financial ratio computation, and automated lending recommendations.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<!-- Client-Side Document Parsers (Free, No Billing Console or Backend Server Required) -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.4.120/pdf.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/tesseract.js@4/dist/tesseract.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/xlsx@0.18.5/dist/xlsx.full.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/mammoth/1.6.0/mammoth.browser.min.js"></script>
<style>
/* ═══════════════════════════════════════════════════
   ROOT DESIGN TOKENS — BANKING DARK GLASSMORPHISM
═══════════════════════════════════════════════════ */
:root {
  --bg0: #060B18;
  --bg1: #0B1226;
  --bg2: #101830;
  --glass: rgba(255,255,255,0.05);
  --glass-h: rgba(255,255,255,0.08);
  --glass-b: rgba(255,255,255,0.09);
  --glass-s: 0 8px 32px rgba(0,0,0,0.45);
  --p1: #6366F1;
  --p2: #8B5CF6;
  --pg: linear-gradient(135deg,#6366F1 0%,#8B5CF6 100%);
  --pg2: linear-gradient(135deg,#818CF8 0%,#A78BFA 100%);
  --glow: 0 0 30px rgba(99,102,241,0.3);
  --ok: #10B981;  --ok-s: rgba(16,185,129,0.15);
  --warn: #F59E0B; --warn-s: rgba(245,158,11,0.15);
  --err: #EF4444;  --err-s: rgba(239,68,68,0.15);
  --inf: #3B82F6;
  --t0: #F8FAFC; --t1: #CBD5E1; --t2: #94A3B8; --t3: #64748B;
  --r-sm: 10px; --r-md: 14px; --r-lg: 20px; --r-xl: 28px;
  --tr: 0.25s cubic-bezier(.4,0,.2,1);
  --tr-s: 0.45s cubic-bezier(.4,0,.2,1);
  --tr-sp: 0.5s cubic-bezier(.175,.885,.32,1.275);
}
*{margin:0;padding:0;box-sizing:border-box;}
html{scroll-behavior:smooth;}
body{
  font-family:'Inter',-apple-system,BlinkMacSystemFont,sans-serif;
  background:var(--bg0);
  background-image:
    radial-gradient(ellipse 80% 50% at 15% 40%, rgba(99,102,241,0.18) 0%, transparent 55%),
    radial-gradient(ellipse 60% 40% at 85% 15%, rgba(139,92,246,0.12) 0%, transparent 45%),
    radial-gradient(ellipse 50% 60% at 50% 100%, rgba(16,185,129,0.06) 0%, transparent 50%);
  min-height:100vh; color:var(--t0);
  overflow-x:hidden;
}
/* scrollbar */
::-webkit-scrollbar{width:5px;height:5px;}
::-webkit-scrollbar-track{background:rgba(255,255,255,.02);}
::-webkit-scrollbar-thumb{background:rgba(255,255,255,.1);border-radius:4px;}
::-webkit-scrollbar-thumb:hover{background:rgba(255,255,255,.18);}

/* ═══════════════════════════════════════════════════
   PROCESSING OVERLAY  (fullscreen, blocks all input)
═══════════════════════════════════════════════════ */
#overlay{
  position:fixed;inset:0;z-index:9999;
  background:rgba(6,11,24,0.93);
  backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px);
  display:none;align-items:center;justify-content:center;
}
#overlay.show{display:flex;animation:ovIn .3s ease;}
@keyframes ovIn{from{opacity:0}to{opacity:1}}
.ov-panel{
  background:linear-gradient(160deg,rgba(11,18,38,0.98),rgba(16,24,48,0.98));
  border:1px solid var(--glass-b);
  border-radius:var(--r-xl);padding:48px 44px;
  width:560px;max-width:93vw;text-align:center;
  box-shadow:0 40px 80px rgba(0,0,0,0.7),0 0 60px rgba(99,102,241,0.08);
}
/* Dual-ring animation */
.ov-rings{width:96px;height:96px;margin:0 auto 28px;position:relative;}
.ring1,.ring2{
  position:absolute;inset:0;border-radius:50%;
  border:3px solid transparent;
}
.ring1{
  border-top-color:var(--p1);border-right-color:var(--p2);
  animation:spin1 1.3s linear infinite;
}
.ring2{
  inset:12px;
  border-bottom-color:var(--ok);border-left-color:rgba(99,102,241,.4);
  animation:spin1 .85s linear infinite reverse;
}
.ring-icon{
  position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);
  font-size:1.5rem;
  background:var(--pg);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;
}
@keyframes spin1{to{transform:rotate(360deg)}}
.ov-title{font-size:1.35rem;font-weight:800;color:var(--t0);margin-bottom:6px;}
.ov-desc{font-size:0.875rem;color:var(--t2);margin-bottom:28px;line-height:1.6;}
/* progress bar */
.pb-track{
  background:rgba(255,255,255,0.06);border-radius:8px;height:8px;overflow:hidden;margin-bottom:8px;
}
.pb-fill{
  height:100%;background:var(--pg);border-radius:8px;
  transition:width .5s cubic-bezier(.4,0,.2,1);position:relative;overflow:hidden;
}
.pb-fill::after{
  content:'';position:absolute;inset:0;
  background:linear-gradient(90deg,transparent 0%,rgba(255,255,255,.3) 50%,transparent 100%);
  animation:shimmer 1.6s infinite;
}
@keyframes shimmer{from{transform:translateX(-100%)}to{transform:translateX(100%)}}
.pb-row{display:flex;justify-content:space-between;font-size:.78rem;color:var(--t3);margin-bottom:24px;}
.pb-pct{font-weight:800;color:var(--p1);font-size:1.05rem;}
/* stage list */
.stage-list{display:flex;flex-direction:column;gap:10px;margin-bottom:20px;}
.stage-item{
  display:flex;align-items:center;gap:12px;
  padding:11px 14px;border-radius:10px;
  background:rgba(255,255,255,0.03);border:1px solid rgba(255,255,255,0.05);
  transition:all var(--tr);
}
.stage-item.s-active{background:rgba(99,102,241,.1);border-color:rgba(99,102,241,.3);}
.stage-item.s-done{background:rgba(16,185,129,.07);border-color:rgba(16,185,129,.2);}
.s-dot{width:10px;height:10px;border-radius:50%;background:rgba(255,255,255,.12);flex-shrink:0;}
.stage-item.s-active .s-dot{display:none;}
.stage-item.s-done .s-dot{display:none;}
.s-spin{
  display:none;width:14px;height:14px;border:2px solid rgba(99,102,241,.3);
  border-top-color:var(--p1);border-radius:50%;animation:spin1 .8s linear infinite;flex-shrink:0;
}
.stage-item.s-active .s-spin{display:block;}
.s-chk{display:none;color:var(--ok);flex-shrink:0;font-size:.85rem;}
.stage-item.s-done .s-chk{display:block;}
.s-txt{font-size:.855rem;color:var(--t3);font-weight:500;flex:1;}
.stage-item.s-active .s-txt{color:var(--t0);}
.stage-item.s-done .s-txt{color:var(--ok);}
.s-time{font-size:.75rem;color:var(--t3);}
/* eta */
.ov-eta{
  display:flex;align-items:center;gap:8px;
  padding:10px 14px;background:rgba(99,102,241,.07);
  border:1px solid rgba(99,102,241,.2);border-radius:8px;
  font-size:.82rem;color:var(--t2);
}
.ov-eta i{color:var(--p1);}

/* ═══════════════════════════════════════════════════
   TOAST NOTIFICATIONS
═══════════════════════════════════════════════════ */
#toasts{position:fixed;top:20px;right:20px;z-index:10000;display:flex;flex-direction:column;gap:10px;}
.toast{
  display:flex;align-items:flex-start;gap:12px;
  padding:14px 18px;
  background:rgba(11,18,38,0.96);backdrop-filter:blur(20px);
  border:1px solid var(--glass-b);border-radius:var(--r-md);
  box-shadow:0 8px 32px rgba(0,0,0,.5);
  max-width:360px;border-left:4px solid;
  animation:tIn .4s var(--tr-sp);
}
.toast.t-ok{border-left-color:var(--ok);}
.toast.t-err{border-left-color:var(--err);}
.toast.t-warn{border-left-color:var(--warn);}
.toast.t-info{border-left-color:var(--inf);}
@keyframes tIn{from{transform:translateX(120%);opacity:0}to{transform:translateX(0);opacity:1}}
@keyframes tOut{from{transform:translateX(0);opacity:1;max-height:80px}to{transform:translateX(120%);opacity:0;max-height:0;padding:0;margin:0}}
.toast.removing{animation:tOut .28s ease forwards;}
.t-ico{font-size:1rem;flex-shrink:0;margin-top:1px;}
.toast.t-ok .t-ico{color:var(--ok);}
.toast.t-err .t-ico{color:var(--err);}
.toast.t-warn .t-ico{color:var(--warn);}
.toast.t-info .t-ico{color:var(--inf);}
.t-body{flex:1;}
.t-title{font-weight:700;font-size:.875rem;color:var(--t0);margin-bottom:2px;}
.t-msg{font-size:.8rem;color:var(--t2);line-height:1.4;}
.t-close{background:none;border:none;color:var(--t3);cursor:pointer;padding:0;font-size:.85rem;line-height:1;flex-shrink:0;}

/* ═══════════════════════════════════════════════════
   NAVBAR
═══════════════════════════════════════════════════ */
.nav{
  position:sticky;top:0;z-index:500;
  background:rgba(6,11,24,.88);backdrop-filter:blur(20px);-webkit-backdrop-filter:blur(20px);
  border-bottom:1px solid var(--glass-b);
  height:62px;padding:0 32px;
  display:flex;align-items:center;justify-content:space-between;
}
.nav-brand{display:flex;align-items:center;gap:12px;}
.nav-logo{
  width:36px;height:36px;border-radius:10px;
  background:var(--pg);display:flex;align-items:center;justify-content:center;
  box-shadow:var(--glow);font-size:1rem;
}
.nav-name{font-size:1.05rem;font-weight:800;
  background:linear-gradient(135deg,#fff 0%,#94A3B8 100%);
  -webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;}
.nav-tag{font-size:.68rem;color:var(--t3);font-weight:400;}
.nav-right{display:flex;align-items:center;gap:14px;}
.nav-pill{
  display:flex;align-items:center;gap:7px;
  padding:5px 13px;background:rgba(255,255,255,.05);
  border:1px solid var(--glass-b);border-radius:20px;
  font-size:.8rem;color:var(--t2);
}
.nav-pill .val{font-weight:700;color:var(--p1);}
.live-dot{
  width:7px;height:7px;border-radius:50%;
  background:var(--ok);box-shadow:0 0 8px rgba(16,185,129,.6);
  animation:ldot 2s infinite;
}
@keyframes ldot{0%,100%{opacity:1;transform:scale(1)}50%{opacity:.6;transform:scale(.8)}}

/* ═══════════════════════════════════════════════════
   STEPPER
═══════════════════════════════════════════════════ */
.stepper-wrap{
  padding:22px 40px 0;
  background:rgba(6,11,24,.6);border-bottom:1px solid rgba(255,255,255,.04);
}
.stepper{
  display:flex;align-items:flex-start;justify-content:space-between;
  max-width:1200px;margin:0 auto;position:relative;
}
.st-track{
  position:absolute;top:17px;
  left:calc(100%/12); right:calc(100%/12);
  height:2px;background:rgba(255,255,255,.06);z-index:0;
}
.st-prog{
  height:100%;background:var(--pg);border-radius:2px;
  transition:width .65s cubic-bezier(.4,0,.2,1);
  box-shadow:0 0 10px rgba(99,102,241,.4);
}
.st-item{
  display:flex;flex-direction:column;align-items:center;gap:8px;
  position:relative;z-index:1;cursor:pointer;padding-bottom:18px;
}
.st-circle{
  width:36px;height:36px;border-radius:50%;
  display:flex;align-items:center;justify-content:center;
  font-weight:700;font-size:.85rem;
  border:2px solid rgba(255,255,255,.1);
  background:rgba(255,255,255,.05);color:var(--t3);
  transition:all var(--tr-s);position:relative;
}
.st-item.active .st-circle{
  background:var(--pg);border-color:transparent;color:#fff;
  box-shadow:var(--glow);
}
.st-item.done .st-circle{
  background:var(--ok);border-color:transparent;color:#fff;
  box-shadow:0 0 16px rgba(16,185,129,.35);
}
.st-item.active .st-circle::after{
  content:'';position:absolute;inset:-5px;border-radius:50%;
  border:2px solid rgba(99,102,241,.35);
  animation:ring-pulse 2s infinite;
}
@keyframes ring-pulse{0%,100%{opacity:1;transform:scale(1)}50%{opacity:0;transform:scale(1.35)}}
.st-lbl{font-size:.7rem;font-weight:600;color:var(--t3);white-space:nowrap;transition:color var(--tr);}
.st-item.active .st-lbl{color:var(--p1);}
.st-item.done .st-lbl{color:var(--ok);}

/* ═══════════════════════════════════════════════════
   LAYOUT & CONTAINERS
═══════════════════════════════════════════════════ */
.main{max-width:1400px;margin:0 auto;padding:32px 36px;}
.page{display:none;animation:pgIn .4s ease;}
.page.active{display:block;}
@keyframes pgIn{from{opacity:0;transform:translateY(12px)}to{opacity:1;transform:translateY(0)}}
.sec-eye{font-size:.72rem;font-weight:700;color:var(--p1);text-transform:uppercase;letter-spacing:2px;margin-bottom:5px;}
.sec-title{font-size:2rem;font-weight:900;color:var(--t0);line-height:1.15;margin-bottom:6px;}
.sec-desc{font-size:.9rem;color:var(--t2);line-height:1.65;}
.sec-hd{margin-bottom:28px;}

/* ═══════════════════════════════════════════════════
   GLASS CARDS
═══════════════════════════════════════════════════ */
.gc{
  background:var(--glass);backdrop-filter:blur(20px);-webkit-backdrop-filter:blur(20px);
  border:1px solid var(--glass-b);border-radius:var(--r-xl);
  padding:28px;box-shadow:var(--glass-s);
  transition:all var(--tr-s);
}
.gc:hover{border-color:rgba(255,255,255,.14);box-shadow:0 16px 48px rgba(0,0,0,.5);}
.gc-title{
  font-size:1.1rem;font-weight:700;color:var(--t0);
  display:flex;align-items:center;gap:10px;margin-bottom:20px;
}
.gc-ico{
  width:34px;height:34px;border-radius:9px;background:var(--pg);
  display:flex;align-items:center;justify-content:center;font-size:.85rem;
  box-shadow:var(--glow);
}

/* ═══════════════════════════════════════════════════
   UPLOAD ZONE
═══════════════════════════════════════════════════ */
.upload-zone{
  border:2px dashed rgba(99,102,241,.4);border-radius:var(--r-lg);
  padding:56px 24px;text-align:center;cursor:pointer;
  transition:all var(--tr-s);
  background:rgba(99,102,241,.03);position:relative;overflow:hidden;
}
.upload-zone::before{
  content:'';position:absolute;inset:0;background:var(--pg);opacity:0;transition:opacity var(--tr-s);
}
.upload-zone:hover,.upload-zone.drag{
  border-color:var(--p1);
  background:rgba(99,102,241,.09);
  transform:scale(1.005);box-shadow:0 0 40px rgba(99,102,241,.15);
}
.upload-zone:hover::before{opacity:.03;}
.uz-ico{
  width:76px;height:76px;background:var(--pg);border-radius:22px;
  display:flex;align-items:center;justify-content:center;
  font-size:1.9rem;margin:0 auto 18px;box-shadow:var(--glow);
  transition:transform var(--tr-sp);position:relative;z-index:1;
}
.upload-zone:hover .uz-ico{transform:translateY(-6px) scale(1.06);}
.uz-title{font-size:1.3rem;font-weight:800;color:var(--t0);margin-bottom:8px;position:relative;z-index:1;}
.uz-sub{font-size:.875rem;color:var(--t2);margin-bottom:14px;position:relative;z-index:1;}
.uz-badges{display:flex;gap:7px;justify-content:center;flex-wrap:wrap;position:relative;z-index:1;}
.fmt-b{
  padding:4px 11px;border-radius:20px;font-size:.75rem;font-weight:600;
  background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.09);color:var(--t2);
}

/* ═══════════════════════════════════════════════════
   FILE CARDS
═══════════════════════════════════════════════════ */
.file-list-wrap{display:flex;flex-direction:column;gap:10px;margin-top:22px;}
.file-card{
  display:flex;align-items:center;gap:14px;
  padding:14px 18px;background:rgba(255,255,255,.04);
  border:1px solid var(--glass-b);border-radius:var(--r-md);
  transition:all var(--tr);animation:fcIn .28s ease;
}
@keyframes fcIn{from{opacity:0;transform:translateX(-16px)}to{opacity:1;transform:translateX(0)}}
.file-card:hover{background:rgba(255,255,255,.07);border-color:rgba(255,255,255,.14);}
.fi{width:42px;height:42px;border-radius:11px;display:flex;align-items:center;justify-content:center;font-size:1.25rem;flex-shrink:0;}
.fi-pdf{background:rgba(239,68,68,.15);color:#EF4444;}
.fi-xls{background:rgba(16,185,129,.15);color:#10B981;}
.fi-img{background:rgba(59,130,246,.15);color:#3B82F6;}
.fi-doc{background:rgba(99,102,241,.15);color:#6366F1;}
.fi-txt{background:rgba(245,158,11,.15);color:#F59E0B;}
.fc-info{flex:1;min-width:0;}
.fc-name{font-weight:600;font-size:.9rem;color:var(--t0);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
.fc-meta{font-size:.775rem;color:var(--t3);margin-top:2px;}
.fc-badge{
  padding:4px 11px;border-radius:20px;font-size:.75rem;font-weight:700;flex-shrink:0;
}
.b-ready{background:rgba(16,185,129,.12);color:var(--ok);border:1px solid rgba(16,185,129,.25);}
.b-proc{background:rgba(245,158,11,.12);color:var(--warn);border:1px solid rgba(245,158,11,.25);}
.b-done{background:rgba(99,102,241,.12);color:var(--p1);border:1px solid rgba(99,102,241,.25);}
.b-err{background:rgba(239,68,68,.12);color:var(--err);border:1px solid rgba(239,68,68,.25);}
.fc-rm{
  width:30px;height:30px;border-radius:8px;background:transparent;border:none;
  color:var(--t3);cursor:pointer;display:flex;align-items:center;justify-content:center;
  transition:all var(--tr);flex-shrink:0;
}
.fc-rm:hover{background:rgba(239,68,68,.14);color:var(--err);}

/* ═══════════════════════════════════════════════════
   BUTTONS
═══════════════════════════════════════════════════ */
.btn{
  display:inline-flex;align-items:center;gap:9px;
  padding:13px 26px;border-radius:var(--r-md);
  font-size:.9rem;font-weight:700;cursor:pointer;border:none;
  transition:all var(--tr-s);font-family:inherit;position:relative;overflow:hidden;
}
.btn::after{content:'';position:absolute;inset:0;background:rgba(255,255,255,.1);opacity:0;transition:opacity var(--tr);}
.btn:hover::after{opacity:1;}
.btn-p{background:var(--pg);color:#fff;box-shadow:0 4px 20px rgba(99,102,241,.35);}
.btn-p:hover{transform:translateY(-2px);box-shadow:0 8px 28px rgba(99,102,241,.45);}
.btn-ok{background:linear-gradient(135deg,#10B981,#059669);color:#fff;box-shadow:0 4px 18px rgba(16,185,129,.3);}
.btn-ok:hover{transform:translateY(-2px);box-shadow:0 8px 26px rgba(16,185,129,.4);}
.btn-g{background:rgba(255,255,255,.07);color:var(--t2);border:1px solid var(--glass-b);}
.btn-g:hover{background:rgba(255,255,255,.12);color:var(--t0);}
.btn-lg{padding:15px 34px;font-size:.95rem;}
.btn:disabled{opacity:.38;cursor:not-allowed;transform:none!important;box-shadow:none!important;}

/* ═══════════════════════════════════════════════════
   EXTRACTION MODE SELECTOR
═══════════════════════════════════════════════════ */
.mode-row{display:flex;gap:11px;flex-wrap:wrap;}
.mode-opt{
  flex:1;min-width:150px;padding:14px 16px;
  border:2px solid rgba(255,255,255,.07);border-radius:var(--r-md);
  cursor:pointer;transition:all var(--tr);
  display:flex;align-items:center;gap:11px;
  background:rgba(255,255,255,.03);
}
.mode-opt:hover{border-color:rgba(99,102,241,.4);background:rgba(99,102,241,.07);}
.mode-opt.sel{border-color:var(--p1);background:rgba(99,102,241,.12);box-shadow:0 0 22px rgba(99,102,241,.12);}
.mode-opt input{display:none;}
.m-ico{
  width:36px;height:36px;border-radius:9px;
  background:rgba(255,255,255,.05);display:flex;align-items:center;justify-content:center;
  font-size:1rem;flex-shrink:0;transition:all var(--tr);
}
.mode-opt.sel .m-ico{background:var(--pg);color:#fff;}
.m-lbl{font-size:.84rem;font-weight:700;color:var(--t2);}
.m-desc{font-size:.72rem;color:var(--t3);margin-top:2px;}
.mode-opt.sel .m-lbl{color:var(--t0);}
#api-row{display:none;gap:10px;margin-top:14px;}
.api-in{
  flex:1;padding:11px 15px;background:rgba(255,255,255,.05);
  border:1px solid rgba(255,255,255,.09);border-radius:var(--r-sm);
  color:var(--t0);font-family:'Courier New',monospace;font-size:.85rem;
}
.api-in:focus{outline:none;border-color:var(--p1);}

/* ═══════════════════════════════════════════════════
   ACTIVITY LOG
═══════════════════════════════════════════════════ */
.log-box{
  background:rgba(0,0,0,.4);border:1px solid rgba(255,255,255,.05);
  border-radius:var(--r-md);padding:14px;
  height:180px;overflow-y:auto;
  font-family:'Courier New',monospace;font-size:.75rem;
}
.log-e{display:flex;gap:9px;margin-bottom:5px;animation:lgIn .2s ease;}
@keyframes lgIn{from{opacity:0;transform:translateY(4px)}to{opacity:1;transform:translateY(0)}}
.l-t{color:#374151;flex-shrink:0;}
.l-ok{color:var(--ok);}.l-err{color:var(--err);}.l-warn{color:var(--warn);}.l-inf{color:var(--t2);}

/* ═══════════════════════════════════════════════════
   VERIFY PAGE — FORM
═══════════════════════════════════════════════════ */
.verify-layout{display:grid;grid-template-columns:1.45fr 1fr;gap:24px;}
.s-div{
  font-size:.72rem;font-weight:800;color:var(--t3);
  text-transform:uppercase;letter-spacing:1.5px;
  margin:20px 0 13px;display:flex;align-items:center;gap:9px;
}
.s-div i{color:var(--p1);}
.s-div::after{content:'';flex:1;height:1px;background:rgba(255,255,255,.06);}
.fg{display:flex;flex-direction:column;gap:5px;}
.fl{font-size:.75rem;font-weight:700;color:var(--t2);text-transform:uppercase;letter-spacing:.4px;display:flex;align-items:center;gap:6px;}
.fc{
  padding:11px 13px;background:rgba(255,255,255,.05);
  border:1px solid rgba(255,255,255,.09);border-radius:var(--r-sm);
  color:var(--t0);font-size:.88rem;font-family:inherit;
  transition:all var(--tr);
}
.fc:focus{outline:none;border-color:var(--p1);background:rgba(99,102,241,.09);box-shadow:0 0 0 3px rgba(99,102,241,.14);}
.fc.ext{
  border-color:rgba(16,185,129,.55);background:rgba(16,185,129,.07);
  animation:extGlow 1.6s ease-out;
}
@keyframes extGlow{0%{box-shadow:0 0 0 5px rgba(16,185,129,.45)}100%{box-shadow:none}}
.ai-badge{
  display:inline-flex;align-items:center;gap:4px;
  background:rgba(16,185,129,.13);color:var(--ok);
  padding:2px 7px;border-radius:10px;font-size:.66rem;font-weight:800;
  border:1px solid rgba(16,185,129,.25);animation:bPop .3s var(--tr-sp);
}
@keyframes bPop{from{transform:scale(.4);opacity:0}to{transform:scale(1);opacity:1}}
.fr{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:12px;}
.fr3{grid-template-columns:1fr 1fr 1fr;}
.fr4{grid-template-columns:1fr 1fr 1fr 1fr;}
select.fc option{background:#101830;color:#fff;}

/* ═══════════════════════════════════════════════════
   DOC PREVIEW PANEL
═══════════════════════════════════════════════════ */
.doc-panel{
  background:rgba(255,255,255,.03);border:1px solid var(--glass-b);
  border-radius:var(--r-lg);padding:18px;position:sticky;top:90px;
}
.dp-title{font-size:.75rem;font-weight:800;color:var(--t3);text-transform:uppercase;letter-spacing:1px;margin-bottom:14px;}
.dp-thumb{
  display:flex;align-items:center;gap:11px;
  padding:11px 14px;background:rgba(255,255,255,.04);
  border:1px solid rgba(255,255,255,.07);border-radius:9px;
  margin-bottom:8px;cursor:pointer;transition:all var(--tr);
}
.dp-thumb:hover{background:rgba(255,255,255,.08);border-color:rgba(99,102,241,.3);}
.dp-thumb.active{background:rgba(99,102,241,.1);border-color:rgba(99,102,241,.4);}
.dp-num{
  width:26px;height:26px;background:var(--pg);border-radius:6px;
  display:flex;align-items:center;justify-content:center;font-size:.72rem;font-weight:800;flex-shrink:0;
}
.dp-inf{flex:1;min-width:0;}
.dp-n{font-size:.8rem;font-weight:700;color:var(--t0);}
.dp-c{font-size:.72rem;color:var(--t3);}

/* ═══════════════════════════════════════════════════
   RESULTS PAGE — KPI CARDS
═══════════════════════════════════════════════════ */
.kpi-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:14px;margin-bottom:22px;}
.kpi-c{
  background:var(--glass);border:1px solid var(--glass-b);border-radius:var(--r-lg);
  padding:20px;transition:all var(--tr-s);position:relative;overflow:hidden;
}
.kpi-c::before{
  content:'';position:absolute;top:0;left:0;right:0;height:3px;
  background:var(--pg);border-radius:3px 3px 0 0;
}
.kpi-c:hover{transform:translateY(-4px);box-shadow:0 14px 36px rgba(0,0,0,.35);border-color:rgba(255,255,255,.14);}
.kpi-lbl{font-size:.72rem;font-weight:700;color:var(--t3);text-transform:uppercase;letter-spacing:.5px;margin-bottom:7px;}
.kpi-val{font-size:1.75rem;font-weight:900;color:var(--t0);line-height:1;margin-bottom:5px;}
.kpi-st{font-size:.75rem;font-weight:600;display:flex;align-items:center;gap:4px;}
.kpi-st.ok{color:var(--ok);}.kpi-st.warn{color:var(--warn);}.kpi-st.bad{color:var(--err);}

/* score ring */
.score-card{
  background:linear-gradient(135deg,rgba(99,102,241,.14),rgba(139,92,246,.09));
  border:1px solid rgba(99,102,241,.28);border-radius:var(--r-xl);padding:36px;text-align:center;
}
.score-lbl{font-size:.78rem;font-weight:700;color:var(--t2);text-transform:uppercase;letter-spacing:2px;margin-bottom:12px;}
.score-num{
  font-size:4.5rem;font-weight:900;line-height:1;
  background:var(--pg);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;
  margin-bottom:4px;
}
.score-max{font-size:.9rem;color:var(--t3);margin-bottom:16px;}
.risk-badge{display:inline-block;padding:5px 18px;border-radius:20px;font-size:.82rem;font-weight:800;}

/* recommendation */
.rec-c{border-radius:var(--r-xl);padding:28px;border:1px solid;}
.rec-c.ra{background:rgba(16,185,129,.08);border-color:rgba(16,185,129,.28);}
.rec-c.rr{background:rgba(245,158,11,.08);border-color:rgba(245,158,11,.28);}
.rec-c.rd{background:rgba(239,68,68,.08);border-color:rgba(239,68,68,.28);}
.rec-ico{width:52px;height:52px;border-radius:14px;display:flex;align-items:center;justify-content:center;font-size:1.5rem;margin-bottom:14px;}
.ra .rec-ico{background:rgba(16,185,129,.18);color:var(--ok);}
.rr .rec-ico{background:rgba(245,158,11,.18);color:var(--warn);}
.rd .rec-ico{background:rgba(239,68,68,.18);color:var(--err);}
.rec-tag{font-size:.72rem;font-weight:800;text-transform:uppercase;letter-spacing:1px;margin-bottom:7px;}
.ra .rec-tag{color:var(--ok);}.rr .rec-tag{color:var(--warn);}.rd .rec-tag{color:var(--err);}
.rec-h{font-size:1.3rem;font-weight:800;color:var(--t0);margin-bottom:10px;}
.rec-p{font-size:.875rem;color:var(--t2);line-height:1.65;}

/* ratio grid */
.ratio-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:14px;}
.ratio-c{
  background:var(--glass);border:1px solid var(--glass-b);border-radius:var(--r-lg);
  padding:18px;transition:all var(--tr-s);
}
.ratio-c:hover{transform:translateY(-3px);box-shadow:0 12px 30px rgba(0,0,0,.3);}
.rn{font-size:.7rem;font-weight:700;color:var(--t3);text-transform:uppercase;letter-spacing:.5px;margin-bottom:10px;}
.rv{font-size:2rem;font-weight:900;margin-bottom:3px;}
.rv.ok{color:var(--ok);}.rv.warn{color:var(--warn);}.rv.bad{color:var(--err);}
.rb-track{height:5px;background:rgba(255,255,255,.06);border-radius:4px;overflow:hidden;margin:8px 0 6px;}
.rb-fill{height:100%;border-radius:4px;transition:width 1s cubic-bezier(.4,0,.2,1);}
.rb-fill.ok{background:var(--ok);}.rb-fill.warn{background:var(--warn);}.rb-fill.bad{background:var(--err);}
.rbm{font-size:.72rem;color:var(--t3);}

/* chart */
.chart-c{background:var(--glass);border:1px solid var(--glass-b);border-radius:var(--r-lg);padding:22px;}
.ch-title{font-size:.875rem;font-weight:700;color:var(--t0);margin-bottom:18px;display:flex;align-items:center;gap:8px;}
.ch-wrap{height:270px;position:relative;}

/* success banner */
.s-banner{
  background:linear-gradient(135deg,rgba(16,185,129,.11),rgba(16,185,129,.04));
  border:1px solid rgba(16,185,129,.28);border-radius:var(--r-xl);
  padding:28px;text-align:center;margin-bottom:24px;
}
.s-banner-ico{
  width:64px;height:64px;background:rgba(16,185,129,.15);border-radius:50%;
  display:flex;align-items:center;justify-content:center;
  font-size:1.8rem;color:var(--ok);margin:0 auto 14px;
}

/* report cards */
.report-row{display:flex;gap:14px;flex-wrap:wrap;margin-top:22px;}
.rpt-c{
  flex:1;min-width:180px;background:var(--glass);
  border:1px solid var(--glass-b);border-radius:var(--r-lg);
  padding:22px;text-align:center;cursor:pointer;transition:all var(--tr-s);
}
.rpt-c:hover{transform:translateY(-4px);border-color:var(--p1);box-shadow:0 12px 30px rgba(99,102,241,.2);}
.rpt-ico{font-size:2.4rem;margin-bottom:10px;}
.rpt-t{font-weight:800;font-size:.9rem;color:var(--t0);}
.rpt-d{font-size:.75rem;color:var(--t3);margin-top:4px;}

/* extraction summary */
.ext-banner{
  display:none;align-items:center;gap:14px;
  padding:14px 20px;background:rgba(16,185,129,.09);
  border:1px solid rgba(16,185,129,.27);border-radius:14px;margin-bottom:22px;
}
.ext-banner.show{display:flex;}
.ext-banner-ico{
  width:38px;height:38px;background:rgba(16,185,129,.18);border-radius:50%;
  display:flex;align-items:center;justify-content:center;color:var(--ok);font-size:1.1rem;flex-shrink:0;
}
.ext-tag{
  margin-left:auto;padding:5px 14px;background:rgba(16,185,129,.14);
  border:1px solid rgba(16,185,129,.28);border-radius:20px;
  font-size:.78rem;font-weight:800;color:var(--ok);flex-shrink:0;
}

/* misc */
.divider{height:1px;background:rgba(255,255,255,.06);margin:20px 0;}
.g2{display:grid;grid-template-columns:1fr 1fr;gap:22px;}
.g3{display:grid;grid-template-columns:1fr 1fr 1fr;gap:18px;}
.mt16{margin-top:16px;}.mt22{margin-top:22px;}.mt28{margin-top:28px;}
.flex-end{display:flex;justify-content:flex-end;gap:10px;}
.flex-c{display:flex;align-items:center;gap:10px;}

@media(max-width:1100px){.verify-layout{grid-template-columns:1fr;}}
@media(max-width:900px){
  .main{padding:20px 16px;}
  .g2,.g3{grid-template-columns:1fr;}
  .fr,.fr3,.fr4{grid-template-columns:1fr;}
  .stepper-wrap{padding:16px 20px 0;}
  .st-track,.st-lbl{display:none;}
  .kpi-grid{grid-template-columns:1fr 1fr;}
  .ratio-grid{grid-template-columns:1fr 1fr;}
}
@media(max-width:480px){
  .kpi-grid,.ratio-grid{grid-template-columns:1fr;}
  .nav{padding:0 16px;}
  .ov-panel{padding:32px 20px;}
}

/* ═══════════════════════════════════════════════════
   FINANCIAL REVIEW TABLES & TABS (NEW)
═══════════════════════════════════════════════════ */
.fin-table {
  width: 100%;
  border-collapse: collapse;
  margin-top: 10px;
  background: rgba(0, 0, 0, 0.2);
  border-radius: var(--r-md);
  overflow: hidden;
}
.fin-table th {
  background: rgba(255, 255, 255, 0.03);
  color: var(--t1);
  font-weight: 700;
  font-size: 0.8rem;
  text-transform: uppercase;
  letter-spacing: 0.5px;
  padding: 12px 14px;
  border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  text-align: left;
}
.fin-table td {
  padding: 12px 14px;
  border-bottom: 1px solid rgba(255, 255, 255, 0.04);
  color: var(--t2);
  font-size: 0.85rem;
}
.fin-table tr:last-child td {
  border-bottom: none;
}
.fin-table tr:hover td {
  background: rgba(255, 255, 255, 0.02);
  color: var(--t0);
}
.fin-table td.num {
  text-align: right;
  font-family: monospace;
}
.fin-table th.num {
  text-align: right;
}
.fin-table td.label-cell {
  font-weight: 600;
  color: var(--t1);
}

.tab-container {
  display: flex;
  gap: 10px;
  margin-bottom: 20px;
  border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  padding-bottom: 10px;
  flex-wrap: wrap;
}
.tab-btn {
  background: rgba(255, 255, 255, 0.03);
  border: 1px solid rgba(255, 255, 255, 0.06);
  border-radius: var(--r-sm);
  color: var(--t2);
  padding: 8px 16px;
  font-size: 0.82rem;
  font-weight: 600;
  cursor: pointer;
  transition: all var(--tr);
  display: flex;
  align-items: center;
  gap: 8px;
}
.tab-btn:hover {
  background: rgba(255, 255, 255, 0.07);
  color: var(--t0);
}
.tab-btn.active {
  background: var(--pg);
  border-color: transparent;
  color: #fff;
  box-shadow: var(--glow);
}
.tab-content {
  display: none;
  animation: pgIn .3s ease;
}
.tab-content.active {
  display: block;
}

.trend-card {
  padding: 18px;
  border-radius: var(--r-md);
  border: 1px solid rgba(255, 255, 255, 0.06);
  background: rgba(255, 255, 255, 0.02);
  transition: all var(--tr);
}
.trend-card.improving {
  border-color: rgba(16, 185, 129, 0.25);
  background: rgba(16, 185, 129, 0.04);
}
.trend-card.declining {
  border-color: rgba(239, 68, 68, 0.25);
  background: rgba(239, 68, 68, 0.04);
}
.trend-card.warning {
  border-color: rgba(245, 158, 11, 0.25);
  background: rgba(245, 158, 11, 0.04);
}
</style>
</head>
<body>

<!-- ═══════════ PROCESSING OVERLAY ═══════════ -->
<div id="overlay">
  <div class="ov-panel">
    <div class="ov-rings">
      <div class="ring1"></div>
      <div class="ring2"></div>
      <div class="ring-icon"><i id="ovIcon" class="fas fa-brain"></i></div>
    </div>
    <div class="ov-title" id="ovTitle">Processing</div>
    <div class="ov-desc" id="ovDesc">Please wait while we process your request...</div>
    <div class="pb-track"><div class="pb-fill" id="pbFill" style="width:0%"></div></div>
    <div class="pb-row">
      <span id="pbLbl">Initializing...</span>
      <span class="pb-pct" id="pbPct">0%</span>
    </div>
    <div class="stage-list" id="stageList"></div>
    <div class="ov-eta"><i class="fas fa-clock"></i><span id="etaTxt">Calculating...</span></div>
  </div>
</div>

<!-- ═══════════ TOASTS ═══════════ -->
<div id="toasts"></div>

<!-- ═══════════ NAVBAR ═══════════ -->
<nav class="nav">
  <div class="nav-brand">
    <div class="nav-logo"><i class="fas fa-brain"></i></div>
    <div>
      <div class="nav-name">AI CREDIT INTELLIGENCE</div>
      <div class="nav-tag">Banking Risk Analysis Platform v4.0</div>
    </div>
  </div>
  <div class="nav-right">
    <div class="nav-pill"><i class="fas fa-file-alt" style="color:var(--p1);font-size:.8rem;"></i> Docs: <span class="val" id="navDocs">0</span></div>
    <div class="nav-pill"><i class="fas fa-star" style="color:var(--warn);font-size:.8rem;"></i> Score: <span class="val" id="navScore">—</span>/100</div>
    <div class="nav-pill"><div class="live-dot"></div>System Ready</div>
  </div>
</nav>

<!-- ═══════════ STEPPER ═══════════ -->
<div class="stepper-wrap">
  <div class="stepper" id="stepper">
    <div class="st-track"><div class="st-prog" id="stProg"></div></div>
    <div class="st-item active" id="st0" onclick="tryStep(0)">
      <div class="st-circle"><i class="fas fa-cloud-upload-alt"></i></div>
      <div class="st-lbl">Upload</div>
    </div>
    <div class="st-item" id="st1" onclick="tryStep(1)">
      <div class="st-circle">2</div>
      <div class="st-lbl">Extract Data</div>
    </div>
    <div class="st-item" id="st2" onclick="tryStep(2)">
      <div class="st-circle">3</div>
      <div class="st-lbl">Verify</div>
    </div>
    <div class="st-item" id="st3" onclick="tryStep(3)">
      <div class="st-circle">4</div>
      <div class="st-lbl">Financials</div>
    </div>
    <div class="st-item" id="st4" onclick="tryStep(4)">
      <div class="st-circle">5</div>
      <div class="st-lbl">Ratios</div>
    </div>
    <div class="st-item" id="st5" onclick="tryStep(5)">
      <div class="st-circle">6</div>
      <div class="st-lbl">Analyze</div>
    </div>
    <div class="st-item" id="st6" onclick="tryStep(6)">
      <div class="st-circle">7</div>
      <div class="st-lbl">Results</div>
    </div>
    <div class="st-item" id="st7" onclick="tryStep(7)">
      <div class="st-circle">8</div>
      <div class="st-lbl">Download</div>
    </div>
  </div>
</div>

<div class="main">

<!-- ═══════════════════════════════════════════════════
     PAGE 0 — UPLOAD
═══════════════════════════════════════════════════ -->
<div class="page active" id="p0">
  <div class="sec-hd">
    <div class="sec-eye">Step 1 of 8 — Document Upload</div>
    <div class="sec-title">Upload Financial Documents</div>
    <div class="sec-desc">Upload bank statements, P&amp;L, balance sheets, GST returns, ITR, or any financial document for AI-powered credit analysis.</div>
  </div>

  <div class="g2" style="align-items:start;gap:28px;">
    <!-- LEFT: Upload zone -->
    <div style="display:flex;flex-direction:column;gap:20px;">
      <div class="gc" style="padding:26px;">
        <input type="file" id="fileInput" multiple accept=".pdf,.xlsx,.xls,.csv,.docx,.doc,.txt,.png,.jpg,.jpeg" style="display:none;" onchange="onFileSelect(event)">
        <label class="upload-zone" id="uz" for="fileInput"
          ondrop="onDrop(event)" ondragover="onDragOver(event)" ondragleave="onDragLeave(event)"
          style="display:block;cursor:pointer;">
          <div class="uz-ico"><i class="fas fa-file-arrow-up"></i></div>
          <div class="uz-title">Drag &amp; Drop Documents</div>
          <div class="uz-sub">or click to browse from your computer</div>
          <div class="uz-badges">
            <span class="fmt-b">📄 PDF</span>
            <span class="fmt-b">📊 Excel</span>
            <span class="fmt-b">🖼️ Images</span>
            <span class="fmt-b">📝 Word</span>
            <span class="fmt-b">📋 CSV</span>
            <span class="fmt-b">🔖 Text</span>
          </div>
        </label>

        <div id="fileList"></div>

        <div style="margin-top:22px;display:flex;gap:10px;flex-wrap:wrap;">
          <button class="btn btn-p btn-lg" id="btnExtract" onclick="startExtract()" disabled>
            <i class="fas fa-magic"></i> Extract Data
          </button>
          <button class="btn btn-g" onclick="clearAll()">
            <i class="fas fa-trash-alt"></i> Clear All
          </button>
        </div>
      </div>

      <!-- Extraction mode -->
      <div class="gc" style="padding:22px;">
        <div class="gc-title" style="margin-bottom:14px;font-size:1rem;">
          <div class="gc-ico" style="width:30px;height:30px;font-size:.8rem;"><i class="fas fa-microchip"></i></div>
          Extraction Engine
        </div>
        <div class="mode-row" id="modeRow">
          <label class="mode-opt" onclick="setMode('vision',this)">
            <input type="radio" name="mode" value="vision">
            <div class="m-ico"><i class="fas fa-eye"></i></div>
            <div>
              <div class="m-lbl">Google Vision OCR</div>
              <div class="m-desc">Cloud AI — Recommended</div>
            </div>
          </label>
          <label class="mode-opt" onclick="setMode('backend',this)">
            <input type="radio" name="mode" value="backend">
            <div class="m-ico"><i class="fas fa-server"></i></div>
            <div>
              <div class="m-lbl">Python Backend</div>
              <div class="m-desc">Local OCR — Free</div>
            </div>
          </label>
          <label class="mode-opt sel" onclick="setMode('local',this)">
            <input type="radio" name="mode" value="local" checked>
            <div class="m-ico"><i class="fas fa-shield-alt"></i></div>
            <div>
              <div class="m-lbl">Client-Side Reader</div>
              <div class="m-desc">Free extraction (No server/billing)</div>
            </div>
          </label>
        </div>
        <div id="api-row">
          <input type="text" class="api-in" id="apiUrl" value="http://localhost:5000/api/extract" placeholder="Backend endpoint URL">
          <button class="btn btn-g" onclick="pingBackend()" style="padding:11px 16px;font-size:.82rem;white-space:nowrap;">
            <i class="fas fa-plug"></i> Test
          </button>
        </div>
      </div>
    </div>

    <!-- RIGHT: Info + log -->
    <div style="display:flex;flex-direction:column;gap:18px;">
      <div class="gc" style="padding:22px;">
        <div class="gc-title" style="font-size:1rem;margin-bottom:14px;">
          <div class="gc-ico" style="width:30px;height:30px;font-size:.8rem;background:linear-gradient(135deg,#10B981,#059669);"><i class="fas fa-list-check"></i></div>
          Supported Documents
        </div>
        <div style="display:flex;flex-direction:column;gap:9px;">
          <div class="flex-c" style="font-size:.86rem;color:var(--t2);"><i class="fas fa-check-circle" style="color:var(--ok);"></i> Bank Statements (12-36 months)</div>
          <div class="flex-c" style="font-size:.86rem;color:var(--t2);"><i class="fas fa-check-circle" style="color:var(--ok);"></i> Profit &amp; Loss Statements</div>
          <div class="flex-c" style="font-size:.86rem;color:var(--t2);"><i class="fas fa-check-circle" style="color:var(--ok);"></i> Balance Sheets (2-3 years)</div>
          <div class="flex-c" style="font-size:.86rem;color:var(--t2);"><i class="fas fa-check-circle" style="color:var(--ok);"></i> GST Returns (GSTR-1, GSTR-3B)</div>
          <div class="flex-c" style="font-size:.86rem;color:var(--t2);"><i class="fas fa-check-circle" style="color:var(--ok);"></i> Income Tax Returns (ITR)</div>
          <div class="flex-c" style="font-size:.86rem;color:var(--t2);"><i class="fas fa-check-circle" style="color:var(--ok);"></i> Cash Flow Statements</div>
          <div class="flex-c" style="font-size:.86rem;color:var(--t2);"><i class="fas fa-check-circle" style="color:var(--ok);"></i> Scanned &amp; Digital PDFs</div>
        </div>
      </div>

      <div class="gc" style="padding:22px;">
        <div class="gc-title" style="font-size:.92rem;margin-bottom:10px;">
          <i class="fas fa-terminal" style="color:var(--p1);"></i> Activity Log
        </div>
        <div class="log-box" id="logBox">
          <div class="log-e"><span class="l-t">[INIT]</span><span class="l-inf"> Platform ready. Upload documents to begin.</span></div>
        </div>
      </div>

      <div class="gc" style="padding:20px;">
        <div class="gc-title" style="font-size:.95rem;margin-bottom:12px;">
          <div class="gc-ico" style="width:30px;height:30px;font-size:.8rem;background:linear-gradient(135deg,#F59E0B,#D97706);"><i class="fas fa-lock"></i></div>
          Privacy &amp; Security
        </div>
        <div style="font-size:.83rem;color:var(--t2);line-height:1.7;">
          <p>✓ Encrypted document transfer</p>
          <p>✓ No data stored after session</p>
          <p>✓ Isolated processing environment</p>
          <p>✓ Banking-grade compliance</p>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- ═══════════════════════════════════════════════════
     PAGE 1 — VERIFY EXTRACTED DATA
═══════════════════════════════════════════════════ -->
<div class="page" id="p1">
  <div class="sec-hd">
    <div class="sec-eye">Step 3 of 8 — Verify Extracted Data</div>
    <div class="sec-title">Review AI-Extracted Data</div>
    <div class="sec-desc">Green-highlighted fields were auto-populated by AI. Correct any values if needed, then click "Run Analysis".</div>
  </div>

  <div class="ext-banner" id="extBanner">
    <div class="ext-banner-ico"><i class="fas fa-robot"></i></div>
    <div>
      <div style="font-weight:800;color:var(--t0);" id="extBanTitle">Extraction Successful</div>
      <div style="font-size:.84rem;color:var(--t2);" id="extBanDesc">Review the populated fields below.</div>
    </div>
    <span class="ext-tag" id="extFieldCount">0 fields</span>
  </div>

  <div class="verify-layout">
    <!-- FORM -->
    <div class="gc" style="padding:26px;">
      <div class="s-div"><i class="fas fa-building"></i> Company Profile</div>
      <div class="fr">
        <div class="fg"><label class="fl" id="lb-businessType">Business Type</label>
          <select class="fc" id="inputBusinessType">
            <option>Sole Proprietorship</option><option>Partnership</option>
            <option>LLP</option><option>Private Limited</option><option>Public Limited</option>
          </select></div>
        <div class="fg"><label class="fl" id="lb-natureOfBusiness">Nature of Business</label>
          <select class="fc" id="inputNatureOfBusiness">
            <option>Retail</option><option>Manufacturing</option><option>Trading</option>
            <option>IT Services</option><option>Healthcare</option><option>Construction</option>
          </select></div>
      </div>

      <div class="s-div"><i class="fas fa-chart-line"></i> Loan Parameters</div>
      <div class="fr3">
        <div class="fg"><label class="fl" id="lb-cibil">CIBIL Score</label><input type="number" class="fc" id="inputCibil" value="" min="300" max="900"></div>
        <div class="fg"><label class="fl" id="lb-proposedLoan">Proposed Loan (₹)</label><input type="number" class="fc" id="inputProposedLoan" value=""></div>
        <div class="fg"><label class="fl" id="lb-proposedEMI">Proposed EMI (₹)</label><input type="number" class="fc" id="inputProposedEMI" value=""></div>
      </div>
      <div class="fr">
        <div class="fg"><label class="fl" id="lb-monthlyIncome">Monthly Income (₹)</label><input type="number" class="fc" id="inputMonthlyIncome" value=""></div>
        <div class="fg"><label class="fl" id="lb-existingEMI">Existing EMI (₹)</label><input type="number" class="fc" id="inputExistingEMI" value=""></div>
      </div>

      <div class="s-div"><i class="fas fa-balance-scale"></i> Balance Sheet</div>
      <div class="fr3">
        <div class="fg"><label class="fl" id="lb-currentAssets">Current Assets (₹)</label><input type="number" class="fc" id="inputCurrentAssets" value=""></div>
        <div class="fg"><label class="fl" id="lb-inventory">Inventory (₹)</label><input type="number" class="fc" id="inputInventory" value=""></div>
        <div class="fg"><label class="fl" id="lb-fixedAssets">Fixed Assets (₹)</label><input type="number" class="fc" id="inputFixedAssets" value=""></div>
      </div>
      <div class="fr3">
        <div class="fg"><label class="fl" id="lb-currentLiabilities">Current Liabilities (₹)</label><input type="number" class="fc" id="inputCurrentLiabilities" value=""></div>
        <div class="fg"><label class="fl" id="lb-longTermDebt">Long-Term Debt (₹)</label><input type="number" class="fc" id="inputLongTermDebt" value=""></div>
        <div class="fg"><label class="fl" id="lb-equity">Equity / Net Worth (₹)</label><input type="number" class="fc" id="inputEquity" value=""></div>
      </div>

      <div class="s-div" style="color:var(--p1);"><i class="fas fa-file-invoice-dollar"></i> P&amp;L — Year 1 (Oldest)</div>
      <div class="fr4" style="display:grid;grid-template-columns:1fr 1fr 1fr 1fr;gap:10px;margin-bottom:12px;">
        <div class="fg"><label class="fl" id="lb-Y1Revenue">Revenue Y1</label><input type="number" class="fc" id="inputY1Revenue" value=""></div>
        <div class="fg"><label class="fl" id="lb-Y1NetProfit">Net Profit Y1</label><input type="number" class="fc" id="inputY1NetProfit" value=""></div>
        <div class="fg"><label class="fl" id="lb-Y1Ebitda">EBITDA Y1</label><input type="number" class="fc" id="inputY1Ebitda" value=""></div>
        <div class="fg"><label class="fl" id="lb-Y1Ocf">Op. CF Y1</label><input type="number" class="fc" id="inputY1Ocf" value=""></div>
      </div>

      <div class="s-div" style="color:var(--p2);"><i class="fas fa-file-invoice-dollar"></i> P&amp;L — Year 2</div>
      <div style="display:grid;grid-template-columns:1fr 1fr 1fr 1fr;gap:10px;margin-bottom:12px;">
        <div class="fg"><label class="fl">Revenue Y2</label><input type="number" class="fc" id="inputY2Revenue" value=""></div>
        <div class="fg"><label class="fl">Net Profit Y2</label><input type="number" class="fc" id="inputY2NetProfit" value=""></div>
        <div class="fg"><label class="fl">EBITDA Y2</label><input type="number" class="fc" id="inputY2Ebitda" value=""></div>
        <div class="fg"><label class="fl">Op. CF Y2</label><input type="number" class="fc" id="inputY2Ocf" value=""></div>
      </div>

      <div class="s-div" style="color:#22D3EE;"><i class="fas fa-file-invoice-dollar"></i> P&amp;L — Year 3 (Latest)</div>
      <div style="display:grid;grid-template-columns:1fr 1fr 1fr 1fr;gap:10px;margin-bottom:20px;">
        <div class="fg"><label class="fl">Revenue Y3</label><input type="number" class="fc" id="inputY3Revenue" value=""></div>
        <div class="fg"><label class="fl">Net Profit Y3</label><input type="number" class="fc" id="inputY3NetProfit" value=""></div>
        <div class="fg"><label class="fl">EBITDA Y3</label><input type="number" class="fc" id="inputY3Ebitda" value=""></div>
        <div class="fg"><label class="fl">Op. CF Y3</label><input type="number" class="fc" id="inputY3Ocf" value=""></div>
      </div>

      <div class="divider"></div>
      <div style="display:flex;gap:10px;justify-content:flex-end;">
        <button class="btn btn-g" onclick="goPage(0)"><i class="fas fa-arrow-left"></i> Back</button>
        <button class="btn btn-p" onclick="goFinancials()"><i class="fas fa-arrow-right"></i> Next: Financial Review</button>
      </div>
    </div>

    <!-- RIGHT: Doc pages + raw text -->
    <div>
      <div class="doc-panel">
        <div class="dp-title"><i class="fas fa-file-alt" style="color:var(--p1);"></i> Extracted Document Pages</div>
        <div id="dpList">
          <div style="text-align:center;padding:28px;color:var(--t3);font-size:.85rem;">
            <i class="fas fa-file-circle-question" style="font-size:2rem;margin-bottom:8px;display:block;"></i>
            No pages extracted yet.
          </div>
        </div>
      </div>
      <div class="gc mt16" style="padding:18px;">
        <div style="font-size:.72rem;font-weight:800;color:var(--t3);text-transform:uppercase;letter-spacing:1px;margin-bottom:10px;">
          Raw Text Preview
        </div>
        <textarea id="rawPrev" readonly
          style="width:100%;height:170px;background:rgba(0,0,0,.4);border:1px solid rgba(255,255,255,.06);border-radius:8px;padding:12px;color:var(--t2);font-family:monospace;font-size:.72rem;resize:none;outline:none;">No extraction yet. Upload and extract first.</textarea>
      </div>
    </div>
  </div>
</div>

<!-- ═══════════════════════════════════════════════════
     PAGE 4 — FINANCIAL STATEMENTS REVIEW (NEW)
═══════════════════════════════════════════════════ -->
<div class="page" id="p4">
  <div class="sec-hd">
    <div class="sec-eye">Step 4 of 8 — Financial Review</div>
    <div class="sec-title">Financial Statements &amp; Cash Flow Trends</div>
    <div class="sec-desc">Review Profit &amp; Loss, Balance Sheet, and Cash Flow statements individually. Trends in cash flow are highlighted below.</div>
  </div>

  <!-- Key Metrics Pill Grid -->
  <div class="kpi-grid" style="margin-bottom: 22px;">
    <div class="kpi-c">
      <div class="kpi-lbl">Revenue Y3 (Latest)</div>
      <div class="kpi-val" id="finRevY3">₹0.00L</div>
      <div class="kpi-st ok" id="finRevGrowth"><i class="fas fa-arrow-up"></i> 0.0% YoY</div>
    </div>
    <div class="kpi-c">
      <div class="kpi-lbl">Net Profit Margin Y3</div>
      <div class="kpi-val" id="finNPMY3">0.0%</div>
      <div class="kpi-st ok" id="finNPMAvg"><i class="fas fa-minus"></i> 0.0% Avg</div>
    </div>
    <div class="kpi-c">
      <div class="kpi-lbl">Current Ratio</div>
      <div class="kpi-val" id="finCRY3">0.00x</div>
      <div class="kpi-st ok" id="finCRStatus"><i class="fas fa-check-circle"></i> Good</div>
    </div>
    <div class="kpi-c">
      <div class="kpi-lbl">Operating Cash Flow Trend</div>
      <div class="kpi-val" id="finCFTrendVal">—</div>
      <div class="kpi-st ok" id="finCFTrendBadge"><i class="fas fa-arrow-up"></i> Stable</div>
    </div>
  </div>

  <!-- Tabbed Statements -->
  <div class="gc" style="padding:26px; margin-bottom:22px;">
    <div class="tab-container">
      <button class="tab-btn active" onclick="switchFinTab('pl-tab', this)">
        <i class="fas fa-file-invoice-dollar"></i> Profit &amp; Loss
      </button>
      <button class="tab-btn" onclick="switchFinTab('bs-tab', this)">
        <i class="fas fa-balance-scale"></i> Balance Sheet
      </button>
      <button class="tab-btn" onclick="switchFinTab('cf-tab', this)">
        <i class="fas fa-chart-line"></i> Cash Flow &amp; Trends
      </button>
    </div>

    <!-- P&L TAB -->
    <div class="tab-content active" id="pl-tab">
      <div class="g2" style="align-items:start; gap:24px;">
        <div>
          <h3 style="margin-bottom:12px;font-size:1rem;color:var(--t0);">Profit &amp; Loss Statement (3-Year Comparison)</h3>
          <table class="fin-table">
            <thead>
              <tr>
                <th>Financial Year</th>
                <th class="num" id="plY1Lbl">Y1</th>
                <th class="num" id="plY2Lbl">Y2</th>
                <th class="num" id="plY3Lbl">Y3 (Latest)</th>
                <th class="num">YoY Change</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td class="label-cell">Revenue / Turnover (₹)</td>
                <td class="num" id="tdPlRevY1">0</td>
                <td class="num" id="tdPlRevY2">0</td>
                <td class="num" id="tdPlRevY3">0</td>
                <td class="num" id="tdPlRevYoY" style="font-weight:600;">0.0%</td>
              </tr>
              <tr>
                <td class="label-cell">EBITDA (₹)</td>
                <td class="num" id="tdPlEbitdaY1">0</td>
                <td class="num" id="tdPlEbitdaY2">0</td>
                <td class="num" id="tdPlEbitdaY3">0</td>
                <td class="num" id="tdPlEbitdaYoY">0.0%</td>
              </tr>
              <tr>
                <td class="label-cell">EBITDA Margin (%)</td>
                <td class="num" id="tdPlEbitdaMarY1">0.0%</td>
                <td class="num" id="tdPlEbitdaMarY2">0.0%</td>
                <td class="num" id="tdPlEbitdaMarY3">0.0%</td>
                <td class="num" id="tdPlEbitdaMarDiff">0.0%</td>
              </tr>
              <tr>
                <td class="label-cell">Net Profit (₹)</td>
                <td class="num" id="tdPlNpY1">0</td>
                <td class="num" id="tdPlNpY2">0</td>
                <td class="num" id="tdPlNpY3">0</td>
                <td class="num" id="tdPlNpYoY">0.0%</td>
              </tr>
              <tr>
                <td class="label-cell">Net Profit Margin (%)</td>
                <td class="num" id="tdPlNpMarY1">0.0%</td>
                <td class="num" id="tdPlNpMarY2">0.0%</td>
                <td class="num" id="tdPlNpMarY3">0.0%</td>
                <td class="num" id="tdPlNpMarDiff">0.0%</td>
              </tr>
            </tbody>
          </table>
        </div>
        <div class="gc" style="background:rgba(255,255,255,0.02); padding:20px;">
          <h4 style="margin-bottom:12px;font-size:.9rem;color:var(--t0);display:flex;align-items:center;gap:6px;">
            <i class="fas fa-brain" style="color:var(--p1);"></i> P&amp;L AI Summary
          </h4>
          <div style="font-size:.85rem;color:var(--t2);line-height:1.6;display:flex;flex-direction:column;gap:12px;margin-bottom:20px;" id="plSummaryText">
            <!-- Dynamically populated summary -->
          </div>
          <h4 style="margin-bottom:12px;font-size:.9rem;color:var(--t0);display:flex;align-items:center;gap:6px;border-top:1px solid rgba(255,255,255,0.05);padding-top:16px;">
            <i class="fas fa-chart-line" style="color:var(--p1);"></i> Profitability Trends (3 Years)
          </h4>
          <div class="chart-c" style="background:rgba(255,255,255,0.02); padding:10px; border-radius: var(--r-sm);">
            <div class="ch-wrap" style="height:200px;"><canvas id="chPlTrend"></canvas></div>
          </div>
        </div>
      </div>
    </div>

    <!-- BALANCE SHEET TAB -->
    <div class="tab-content" id="bs-tab">
      <div class="g2" style="align-items:start; gap:24px;">
        <div>
          <h3 style="margin-bottom:12px;font-size:1rem;color:var(--t0);">Balance Sheet Composition</h3>
          <table class="fin-table">
            <thead>
              <tr>
                <th>Particulars</th>
                <th class="num">Amount (₹)</th>
                <th class="num">% of Total Assets</th>
              </tr>
            </thead>
            <tbody>
              <tr style="background:rgba(255,255,255,0.02);"><td colspan="3" style="font-weight:700;color:var(--t0);font-size:.78rem;">ASSETS</td></tr>
              <tr>
                <td class="label-cell" style="padding-left: 24px;">Current Assets</td>
                <td class="num" id="tdBsCA">0</td>
