                <td class="num" id="tdBsFAPct">0.0%</td>
              </tr>
              <tr style="font-weight:700; color:var(--t0); background:rgba(255,255,255,0.03);">
                <td>Total Assets</td>
                <td class="num" id="tdBsTotalAssets">0</td>
                <td class="num">100.0%</td>
              </tr>
              <tr style="background:rgba(255,255,255,0.02);"><td colspan="3" style="font-weight:700;color:var(--t0);font-size:.78rem;">LIABILITIES &amp; EQUITY</td></tr>
              <tr>
                <td class="label-cell" style="padding-left: 24px;">Current Liabilities</td>
                <td class="num" id="tdBsCL">0</td>
                <td class="num" id="tdBsCLPct">0.0%</td>
              </tr>
              <tr>
                <td class="label-cell" style="padding-left: 24px;">Long-Term Debt</td>
                <td class="num" id="tdBsLD">0</td>
                <td class="num" id="tdBsLDPct">0.0%</td>
              </tr>
              <tr>
                <td class="label-cell" style="padding-left: 24px;">Equity / Net Worth</td>
                <td class="num" id="tdBsEQ">0</td>
                <td class="num" id="tdBsEQPct">0.0%</td>
              </tr>
              <tr style="font-weight:700; color:var(--t0); background:rgba(255,255,255,0.03);">
                <td>Total Liabilities &amp; Equity</td>
                <td class="num" id="tdBsTotalLiabEquity">0</td>
                <td class="num">100.0%</td>
              </tr>
            </tbody>
          </table>
        </div>
        <div class="gc" style="background:rgba(255,255,255,0.02); padding:20px;">
          <h4 style="margin-bottom:12px;font-size:.9rem;color:var(--t0);display:flex;align-items:center;gap:6px;">
            <i class="fas fa-chart-pie" style="color:var(--p2);"></i> Capital Structure Analysis
          </h4>
          <div style="font-size:.85rem;color:var(--t2);line-height:1.6;display:flex;flex-direction:column;gap:12px;" id="bsSummaryText">
            <!-- Dynamically populated summary -->
          </div>
        </div>
      </div>
    </div>

    <!-- CASH FLOW & TRENDS TAB -->
    <div class="tab-content" id="cf-tab">
      <div class="g2" style="align-items:start; gap:24px;">
        <div>
          <h3 style="margin-bottom:12px;font-size:1rem;color:var(--t0);">Operating Cash Flow Statement</h3>
          <table class="fin-table">
            <thead>
              <tr>
                <th>Cash Flow Particulars</th>
                <th class="num" id="cfY1Lbl">Y1</th>
                <th class="num" id="cfY2Lbl">Y2</th>
                <th class="num" id="cfY3Lbl">Y3 (Latest)</th>
                <th class="num">YoY Growth (Y3)</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td class="label-cell">Operating Cash Flow (₹)</td>
                <td class="num" id="tdCfOcfY1">0</td>
                <td class="num" id="tdCfOcfY2">0</td>
                <td class="num" id="tdCfOcfY3">0</td>
                <td class="num" id="tdCfOcfYoY" style="font-weight:600;">0.0%</td>
              </tr>
              <tr>
                <td class="label-cell">OCF to Revenue (%)</td>
                <td class="num" id="tdCfOcfRevY1">0.0%</td>
                <td class="num" id="tdCfOcfRevY2">0.0%</td>
                <td class="num" id="tdCfOcfRevY3">0.0%</td>
                <td class="num" id="tdCfOcfRevYoY">0.0%</td>
              </tr>
              <tr>
                <td class="label-cell">OCF to EBITDA (%)</td>
                <td class="num" id="tdCfOcfEbitdaY1">0.0%</td>
                <td class="num" id="tdCfOcfEbitdaY2">0.0%</td>
                <td class="num" id="tdCfOcfEbitdaY3">0.0%</td>
                <td class="num" id="tdCfOcfEbitdaYoY">0.0%</td>
              </tr>
            </tbody>
          </table>

          <div style="margin-top:20px;">
            <div class="trend-card" id="cfTrendCard">
              <div style="display:flex;align-items:center;gap:10px;margin-bottom:10px;">
                <div id="cfTrendIcon" style="width:30px;height:30px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:.85rem;font-weight:bold;">
                  <i class="fas fa-chart-line"></i>
                </div>
                <div>
                  <div style="font-size:.7rem;font-weight:700;color:var(--t3);text-transform:uppercase;letter-spacing:.5px;">Cash Flow Trend Direction</div>
                  <div style="font-weight:800;font-size:1.05rem;" id="cfTrendTitle">Evaluating...</div>
                </div>
              </div>
              <p style="font-size:.84rem;color:var(--t2);line-height:1.6;" id="cfTrendDesc">
                Analyzing extracted operating cash flow history...
              </p>
            </div>
          </div>
        </div>
        <div>
          <h3 style="margin-bottom:12px;font-size:1rem;color:var(--t0);display:flex;align-items:center;gap:8px;">
            <i class="fas fa-chart-line" style="color:var(--p1);"></i> Operating Cash Flow Trend (3 Years)
          </h3>
          <div class="chart-c" style="background:rgba(255,255,255,0.02); padding:18px;">
            <div class="ch-wrap" style="height:270px;"><canvas id="chCfTrend"></canvas></div>
