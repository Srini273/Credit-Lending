<!-- ═══════════════════════════════════════════════════
     PAGE 5 — FINANCIAL RATIOS (NEW)
═══════════════════════════════════════════════════ -->
<div class="page" id="p5">
  <div class="sec-hd">
    <div class="sec-eye">Step 5 of 8 — Financial Ratios</div>
    <div class="sec-title">Key Financial Ratios (3-Year Comparison)</div>
    <div class="sec-desc">Analyze Profitability, Liquidity, Leverage, Efficiency, and Growth ratios. Ratios are computed using standard formulas.</div>
  </div>

  <div class="g2" style="align-items:start; gap:24px; margin-bottom:22px;">
    <div>
      <h3 style="margin-bottom:12px;font-size:1rem;color:var(--t0);">Comparative Ratios Table</h3>
      <table class="fin-table">
        <thead>
          <tr>
            <th>Ratio Category &amp; Name</th>
            <th>Formula Hint</th>
            <th class="num" id="ratY1Lbl">Y1</th>
            <th class="num" id="ratY2Lbl">Y2</th>
            <th class="num" id="ratY3Lbl">Y3 (Latest)</th>
            <th class="num">Benchmark</th>
          </tr>
        </thead>
        <tbody>
          <tr style="background:rgba(255,255,255,0.02);"><td colspan="6" style="font-weight:700;color:var(--t0);font-size:.78rem;">PROFITABILITY</td></tr>
          <tr>
            <td class="label-cell" style="padding-left: 24px;">Net Profit Margin</td>
            <td style="font-size:.72rem;color:var(--t3);">Net Profit / Revenue</td>
            <td class="num" id="tdRatNpmY1">—</td>
            <td class="num" id="tdRatNpmY2">—</td>
            <td class="num" id="tdRatNpmY3">—</td>
            <td class="num">≥ 15.0%</td>
          </tr>
          <tr>
            <td class="label-cell" style="padding-left: 24px;">EBITDA Margin</td>
            <td style="font-size:.72rem;color:var(--t3);">EBITDA / Revenue</td>
            <td class="num" id="tdRatEbitdaMarY1">—</td>
            <td class="num" id="tdRatEbitdaMarY2">—</td>
            <td class="num" id="tdRatEbitdaMarY3">—</td>
            <td class="num">≥ 20.0%</td>
          </tr>
          <tr>
            <td class="label-cell" style="padding-left: 24px;">Operating Margin</td>
            <td style="font-size:.72rem;color:var(--t3);">EBIT / Revenue</td>
            <td class="num" id="tdRatOpMarY1">—</td>
            <td class="num" id="tdRatOpMarY2">—</td>
            <td class="num" id="tdRatOpMarY3">—</td>
            <td class="num">≥ 15.0%</td>
          </tr>

          <tr style="background:rgba(255,255,255,0.02);"><td colspan="6" style="font-weight:700;color:var(--t0);font-size:.78rem;">LIQUIDITY</td></tr>
          <tr>
            <td class="label-cell" style="padding-left: 24px;">Current Ratio</td>
            <td style="font-size:.72rem;color:var(--t3);">Current Assets / Current Liabilities</td>
            <td class="num">—</td>
            <td class="num">—</td>
            <td class="num" id="tdRatCRY3">—</td>
            <td class="num">≥ 1.50x</td>
          </tr>
          <tr>
            <td class="label-cell" style="padding-left: 24px;">Quick Ratio</td>
            <td style="font-size:.72rem;color:var(--t3);">(Current Assets - Inventory) / Current Liabilities</td>
            <td class="num">—</td>
            <td class="num">—</td>
            <td class="num" id="tdRatQRY3">—</td>
            <td class="num">≥ 1.00x</td>
          </tr>

          <tr style="background:rgba(255,255,255,0.02);"><td colspan="6" style="font-weight:700;color:var(--t0);font-size:.78rem;">LEVERAGE</td></tr>
          <tr>
            <td class="label-cell" style="padding-left: 24px;">Debt-to-Equity</td>
            <td style="font-size:.72rem;color:var(--t3);">Total Debt / Equity</td>
            <td class="num">—</td>
            <td class="num">—</td>
            <td class="num" id="tdRatDEY3">—</td>
            <td class="num">≤ 1.00x</td>
          </tr>
          <tr>
            <td class="label-cell" style="padding-left: 24px;">Debt Ratio</td>
            <td style="font-size:.72rem;color:var(--t3);">Total Debt / Total Assets</td>
            <td class="num">—</td>
            <td class="num">—</td>
            <td class="num" id="tdRatDRY3">—</td>
            <td class="num">≤ 50.0%</td>
          </tr>

          <tr style="background:rgba(255,255,255,0.02);"><td colspan="6" style="font-weight:700;color:var(--t0);font-size:.78rem;">EFFICIENCY</td></tr>
          <tr>
            <td class="label-cell" style="padding-left: 24px;">Asset Turnover</td>
            <td style="font-size:.72rem;color:var(--t3);">Revenue / Total Assets</td>
            <td class="num">—</td>
            <td class="num">—</td>
            <td class="num" id="tdRatATY3">—</td>
            <td class="num">≥ 1.20x</td>
          </tr>

          <tr style="background:rgba(255,255,255,0.02);"><td colspan="6" style="font-weight:700;color:var(--t0);font-size:.78rem;">GROWTH</td></tr>
          <tr>
            <td class="label-cell" style="padding-left: 24px;">Revenue Growth</td>
            <td style="font-size:.72rem;color:var(--t3);">YoY Revenue Change (%)</td>
            <td class="num">—</td>
            <td class="num" id="tdRatRevG2">—</td>
            <td class="num" id="tdRatRevG3">—</td>
            <td class="num">≥ 10.0%</td>
          </tr>
          <tr>
            <td class="label-cell" style="padding-left: 24px;">Profit Growth</td>
            <td style="font-size:.72rem;color:var(--t3);">YoY Net Profit Change (%)</td>
            <td class="num">—</td>
            <td class="num" id="tdRatNPGB2">—</td>
            <td class="num" id="tdRatNPGB3">—</td>
            <td class="num">≥ 10.0%</td>
          </tr>
        </tbody>
      </table>
    </div>

    <!-- Right Side: AI summary + Chart -->
    <div style="display:flex; flex-direction:column; gap:20px; width:100%; max-width:420px;">
      <div class="gc" style="background:rgba(255,255,255,0.02); padding:20px;">
        <h4 style="margin-bottom:12px;font-size:.9rem;color:var(--t0);display:flex;align-items:center;gap:6px;">
          <i class="fas fa-brain" style="color:var(--p2);"></i> Ratios AI Summary
        </h4>
        <div style="font-size:.85rem;color:var(--t2);line-height:1.6;display:flex;flex-direction:column;gap:12px;" id="ratiosSummaryText">
          <!-- Dynamically populated summary -->
        </div>
      </div>

      <div class="gc" style="background:rgba(255,255,255,0.02); padding:20px;">
        <h4 style="margin-bottom:12px;font-size:.9rem;color:var(--t0);display:flex;align-items:center;gap:6px;">
          <i class="fas fa-chart-line" style="color:var(--ok);"></i> Margins Trend Line
        </h4>
        <div class="chart-c" style="background:rgba(255,255,255,0.02); padding:10px; border-radius: var(--r-sm);">
          <div class="ch-wrap" style="height:220px;"><canvas id="chRatiosTrend"></canvas></div>
        </div>
      </div>
    </div>
  </div>

  <div class="flex-c">
    <button class="btn btn-g" onclick="goPage(4)"><i class="fas fa-arrow-left"></i> Back to Financials</button>
    <button class="btn btn-p" onclick="runAnalysis()"><i class="fas fa-chart-bar"></i> Proceed to Analysis</button>
  </div>
</div>

<!-- ═══════════════════════════════════════════════════
     PAGE 2 — RESULTS
═══════════════════════════════════════════════════ -->
<div class="page" id="p2">
  <div class="sec-hd">
    <div class="sec-eye">Step 7 of 8 — Credit Analysis Results</div>
    <div class="sec-title">AI Credit Analysis Report</div>
    <div class="sec-desc">Complete financial analysis with ratios, risk score, and automated lending recommendation.</div>
  </div>

  <div class="s-banner">
    <div class="s-banner-ico"><i class="fas fa-check"></i></div>
    <div style="font-size:1.15rem;font-weight:800;color:var(--t0);margin-bottom:4px;">Analysis Complete</div>
    <div style="font-size:.875rem;color:var(--t2);">All metrics computed. Credit recommendation ready.</div>
  </div>

  <!-- KPIs -->
  <div class="kpi-grid" id="kpiGrid">
    <div class="kpi-c"><div class="kpi-lbl">AI Credit Score</div><div class="kpi-val" id="kScore">—</div><div class="kpi-st" id="kScoreSt"></div></div>
    <div class="kpi-c"><div class="kpi-lbl">Current Ratio</div><div class="kpi-val" id="kCR">—</div><div class="kpi-st" id="kCRSt"></div></div>
    <div class="kpi-c"><div class="kpi-lbl">FOIR</div><div class="kpi-val" id="kFOIR">—</div><div class="kpi-st" id="kFOIRSt"></div></div>
