    <div class="kpi-c"><div class="kpi-lbl">Net Margin Y3</div><div class="kpi-val" id="kNM">—</div><div class="kpi-st" id="kNMSt"></div></div>
    <div class="kpi-c"><div class="kpi-lbl">DSCR</div><div class="kpi-val" id="kDSCR">—</div><div class="kpi-st" id="kDSCRSt"></div></div>
  </div>

  <!-- Rec + Score -->
  <div class="g2" style="margin-bottom:22px;">
    <div class="rec-c ra" id="recCard">
      <div class="rec-ico"><i class="fas fa-thumbs-up" id="recIco"></i></div>
      <div class="rec-tag" id="recTag">APPROVED</div>
      <div class="rec-h" id="recH">Loan Approved</div>
      <div class="rec-p" id="recP">Strong financial profile meets lending criteria.</div>
    </div>
    <div class="score-card">
      <svg viewBox="0 0 160 160" style="width:130px;height:130px;display:block;margin:0 auto 10px;">
        <defs>
          <linearGradient id="sg" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" stop-color="#6366F1"/>
            <stop offset="100%" stop-color="#8B5CF6"/>
          </linearGradient>
        </defs>
        <circle cx="80" cy="80" r="64" fill="none" stroke="rgba(255,255,255,.05)" stroke-width="12"/>
        <circle cx="80" cy="80" r="64" fill="none" stroke="url(#sg)" stroke-width="12"
          stroke-linecap="round" stroke-dasharray="402" stroke-dashoffset="402"
          id="scoreRing" transform="rotate(-90 80 80)" style="transition:stroke-dashoffset 1.6s cubic-bezier(.4,0,.2,1);"/>
      </svg>
      <div class="score-lbl">AI Credit Score</div>
      <div class="score-num" id="scoreBig">—</div>
      <div class="score-max">out of 100</div>
      <div class="risk-badge" id="riskBadge" style="background:rgba(99,102,241,.15);color:var(--p1);">—</div>
    </div>
  </div>

  <!-- Charts -->
  <div class="g2" style="margin-bottom:22px;">
    <div class="chart-c">
      <div class="ch-title"><i class="fas fa-chart-bar" style="color:var(--p1);"></i> Revenue & Profitability (3 Years)</div>
      <div class="ch-wrap"><canvas id="chRev"></canvas></div>
    </div>
    <div class="chart-c">
      <div class="ch-title"><i class="fas fa-chart-pie" style="color:var(--p2);"></i> Balance Sheet Composition</div>
      <div class="ch-wrap"><canvas id="chBal"></canvas></div>
    </div>
  </div>

  <!-- Ratios -->
  <div class="gc" style="padding:26px;margin-bottom:22px;">
    <div class="gc-title" style="margin-bottom:22px;">
      <div class="gc-ico"><i class="fas fa-calculator" style="font-size:.8rem;"></i></div>
      Financial Ratios — Detailed Analysis
    </div>
    <div class="ratio-grid" id="ratioGrid"></div>
  </div>

  <div class="flex-c">
    <button class="btn btn-g" onclick="goPage(4)"><i class="fas fa-arrow-left"></i> Back to Financials</button>
    <button class="btn btn-p" onclick="goPage(3)"><i class="fas fa-download"></i> Download Report</button>
  </div>
</div>

<!-- ═══════════════════════════════════════════════════
     PAGE 3 — DOWNLOAD
═══════════════════════════════════════════════════ -->
<div class="page" id="p3">
  <div class="sec-hd">
    <div class="sec-eye">Step 8 of 8 — Report Download</div>
    <div class="sec-title">Download Credit Report</div>
    <div class="sec-desc">Your comprehensive AI credit analysis report is ready. Download in your preferred format.</div>
  </div>
  <div class="s-banner">
    <div class="s-banner-ico"><i class="fas fa-file-check"></i></div>
    <div style="font-size:1.15rem;font-weight:800;color:var(--t0);margin-bottom:4px;">Report Ready</div>
    <div style="font-size:.875rem;color:var(--t2);">All financial ratios, risk scores, and recommendations are compiled.</div>
  </div>
  <div class="report-row">
    <div class="rpt-c" onclick="dlReport('pdf')">
      <div class="rpt-ico" style="color:#EF4444;">📄</div>
      <div class="rpt-t">PDF Report</div>
      <div class="rpt-d">Complete formatted credit document</div>
    </div>
    <div class="rpt-c" onclick="dlReport('csv')">
      <div class="rpt-ico" style="color:#10B981;">📊</div>
      <div class="rpt-t">Excel / CSV</div>
      <div class="rpt-d">Spreadsheet with all metrics</div>
    </div>
    <div class="rpt-c" onclick="dlReport('json')">
      <div class="rpt-ico" style="color:#6366F1;">📋</div>
      <div class="rpt-t">JSON Export</div>
      <div class="rpt-d">API-ready structured data</div>
    </div>
  </div>
  <div class="flex-c mt28">
    <button class="btn btn-g" onclick="goPage(2)"><i class="fas fa-arrow-left"></i> Back to Results</button>
    <button class="btn btn-p" onclick="newAnalysis()"><i class="fas fa-plus"></i> New Analysis</button>
  </div>
</div>

</div><!-- /main -->

<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.0/chart.umd.min.js"></script>
<script>
'use strict';
/* ═══════════════════════════════════════
   CONFIG
═══════════════════════════════════════ */
const VISION_KEY = 'AIzaSyByNxAB3WuwC-kOjOhO7on8n5kRW8wSJhc';
const VISION_URL = `https://vision.googleapis.com/v1/images:annotate?key=${VISION_KEY}`;

/* ═══════════════════════════════════════
   STATE
═══════════════════════════════════════ */
let S = {
  page: 0,               // current visible page (0-3)
  stepIdx: 0,            // current stepper index (0-5)
  maxStep: 0,            // furthest unlocked step
  files: [],             // File[]
  mode: 'local',
  extractedData: null,
  rawText: '',
  extractedFields: [],
  analysis: null,
  busy: false,
};

// Step→page mapping
const STEP_PAGE = { 0:0, 1:'overlay', 2:1, 3:4, 4:5, 5:'overlay', 6:2, 7:3 };
// Page→step mapping
const PAGE_STEP = { 0:0, 1:2, 4:3, 5:4, 2:6, 3:7 };

let charts = {};

/* ═══════════════════════════════════════
   STEPPER & NAVIGATION
═══════════════════════════════════════ */
function tryStep(idx) {
  if (S.busy) { toast('warn','Please Wait','Processing is in progress.'); return; }
  if (idx > S.maxStep) { toast('info','Complete Previous Steps','Please complete the earlier steps first.'); return; }
  if (STEP_PAGE[idx] === 'overlay') return; // can't navigate to overlay steps
  activateStep(idx);
  goPage(STEP_PAGE[idx] === undefined ? 0 : STEP_PAGE[idx]);
}

function activateStep(idx) {
  S.stepIdx = idx;
  if (idx > S.maxStep) S.maxStep = idx;
  for (let i = 0; i < 8; i++) {
    const el = document.getElementById('st' + i);
    if (!el) continue;
    el.classList.remove('active','done');
    if (i < idx) el.classList.add('done');
    else if (i === idx) el.classList.add('active');
  }
  document.getElementById('stProg').style.width = (idx / 7 * 100) + '%';
}

function goPage(pIdx) {
  document.querySelectorAll('.page').forEach(p => p.classList.remove('active'));
  document.getElementById('p' + pIdx).classList.add('active');
  S.page = pIdx;
  activateStep(PAGE_STEP[pIdx] || 0);
  window.scrollTo({ top: 0, behavior: 'smooth' });
}

/* ═══════════════════════════════════════
   FILE HANDLING
═══════════════════════════════════════ */
function onDragOver(e){ e.preventDefault(); document.getElementById('uz').classList.add('drag'); }
function onDragLeave(){ document.getElementById('uz').classList.remove('drag'); }
function onDrop(e){ e.preventDefault(); document.getElementById('uz').classList.remove('drag'); addFiles(e.dataTransfer.files); }
function onFileSelect(e){ addFiles(e.target.files); }

function addFiles(fList) {
  const added = [];
  Array.from(fList).forEach(f => {
    if (!S.files.some(x => x.name===f.name && x.size===f.size)) {
      S.files.push(f); added.push(f.name);
    }
  });
  renderFiles();
  if (added.length) {
    log(`Added ${added.length} file(s): ${added.join(', ')}`, 'ok');
    document.getElementById('navDocs').textContent = S.files.length;
    document.getElementById('btnExtract').disabled = false;
    toast('ok','Files Added', `${added.length} file(s) ready for extraction.`);
  }
}

function fIcon(name) {
  const e = name.toLowerCase().split('.').pop();
  if (e==='pdf') return ['fa-file-pdf','fi-pdf'];
  if (['xlsx','xls'].includes(e)) return ['fa-file-excel','fi-xls'];
  if (e==='csv') return ['fa-table','fi-xls'];
  if (['png','jpg','jpeg'].includes(e)) return ['fa-file-image','fi-img'];
  if (['docx','doc'].includes(e)) return ['fa-file-word','fi-doc'];
  return ['fa-file','fi-txt'];
}

function fSize(b){ return b>1048576 ? (b/1048576).toFixed(1)+' MB' : (b/1024).toFixed(1)+' KB'; }

function renderFiles() {
  const c = document.getElementById('fileList');
  if (!S.files.length){ c.innerHTML=''; return; }
  c.innerHTML = `<div style="font-size:.72rem;font-weight:800;color:var(--t3);text-transform:uppercase;letter-spacing:.5px;margin:18px 0 8px;">${S.files.length} File(s) Ready</div><div class="file-list-wrap">` +
    S.files.map((f,i) => {
      const [ico,cls] = fIcon(f.name);
      return `<div class="file-card" id="fc${i}">
        <div class="fi ${cls}"><i class="fas ${ico}"></i></div>
        <div class="fc-info">
          <div class="fc-name">${f.name}</div>
          <div class="fc-meta">${fSize(f.size)} · ${f.type||'Document'}</div>
        </div>
        <span class="fc-badge b-ready" id="fs${i}">✓ Ready</span>
        <button class="fc-rm" onclick="rmFile(${i})" title="Remove"><i class="fas fa-times"></i></button>
      </div>`;
    }).join('') + '</div>';
}

function rmFile(i){ const n=S.files[i].name; S.files.splice(i,1); renderFiles(); document.getElementById('navDocs').textContent=S.files.length; if(!S.files.length) document.getElementById('btnExtract').disabled=true; log(`Removed: ${n}`,'warn'); }
function clearAll(){ S.files=[]; renderFiles(); document.getElementById('navDocs').textContent='0'; document.getElementById('btnExtract').disabled=true; log('All files cleared.','warn'); }
function setFStatus(i,cls,txt){ const e=document.getElementById('fs'+i); if(e){e.className='fc-badge '+cls;e.textContent=txt;} }

/* ═══════════════════════════════════════
   MODE
═══════════════════════════════════════ */
function setMode(m,el) {
  S.mode=m;
  document.querySelectorAll('.mode-opt').forEach(x=>x.classList.remove('sel'));
  el.classList.add('sel');
  document.getElementById('api-row').style.display = m==='backend'?'flex':'none';
  log(`Mode: ${m}`,'inf');
}

async function pingBackend() {
  const url = document.getElementById('apiUrl').value.replace('/extract','/ping');
  try{ const r=await fetch(url); const d=await r.json(); toast('ok','Connected',d.message||'Backend online.'); }
  catch{ toast('err','Failed','Cannot reach backend. Is the server running?'); }
}

/* ═══════════════════════════════════════
   OVERLAY CONTROL
═══════════════════════════════════════ */
const EXT_STAGES = [
  { t:'Uploading documents', d:'~2s' },
  { t:'Detecting document type', d:'~1s' },
  { t:'Rendering pages for OCR', d:'~3s' },
  { t:'Extracting text with Vision AI', d:'~5s' },
  { t:'Parsing financial fields', d:'~2s' },
  { t:'Validating extracted data', d:'~1s' },
];
const ANA_STAGES = [
  { t:'Computing liquidity ratios', d:'~1s' },
  { t:'Calculating leverage metrics', d:'~1s' },
  { t:'Profitability analysis', d:'~1s' },
  { t:'Running credit risk model', d:'~2s' },
  { t:'Generating AI credit score', d:'~1s' },
  { t:'Preparing recommendation', d:'~1s' },
];

function showOverlay(icon, title, desc, stages) {
  S.busy = true;
  document.getElementById('ovIcon').className = 'fas fa-' + icon;
  document.getElementById('ovTitle').textContent = title;
  document.getElementById('ovDesc').textContent = desc;
  setProgress(0,'Initializing...');
  const sl = document.getElementById('stageList');
  sl.innerHTML = stages.map((s,i) => `
    <div class="stage-item" id="sg${i}">
      <div class="s-dot"></div><div class="s-spin"></div>
      <i class="fas fa-check s-chk"></i>
      <div class="s-txt">${s.t}</div>
      <div class="s-time">${s.d}</div>
    </div>`).join('');
  document.getElementById('overlay').classList.add('show');
}

function hideOverlay() {
  document.getElementById('overlay').classList.remove('show');
  S.busy = false;
}

function setProgress(pct, lbl) {
  document.getElementById('pbFill').style.width = Math.min(100,pct) + '%';
  document.getElementById('pbPct').textContent = Math.round(pct) + '%';
  if (lbl) document.getElementById('pbLbl').textContent = lbl;
}

function setStage(idx, stages) {
  stages.forEach((_,i) => {
    const el = document.getElementById('sg' + i);
    if (!el) return;
    el.classList.remove('s-active','s-done');
    if (i < idx) el.classList.add('s-done');
    else if (i === idx) el.classList.add('s-active');
  });
  const rem = stages.length - idx;
  document.getElementById('etaTxt').textContent = `Estimated time remaining: ~${rem * 2}s`;
  if (stages[idx]) document.getElementById('ovTitle').textContent = stages[idx].t;
}

const sleep = ms => new Promise(r => setTimeout(r, ms));

/* ═══════════════════════════════════════
   VISION OCR
═══════════════════════════════════════ */
async function visionOCR(b64) {
  const res = await fetch(VISION_URL, {
    method:'POST',
    headers:{'Content-Type':'application/json'},
    body: JSON.stringify({ requests:[{ image:{content:b64}, features:[{type:'DOCUMENT_TEXT_DETECTION'}] }] })
  });
  if (!res.ok) {
    const err = await res.json();
    throw new Error(err.error?.message || `HTTP ${res.status}`);
  }
  const d = await res.json();
  return d.responses?.[0]?.textAnnotations?.[0]?.description || '';
}

function toB64(file) {
  return new Promise((res,rej) => {
    const r = new FileReader();
    r.onload = e => res(e.target.result.split(',')[1]);
    r.onerror = rej;
    r.readAsDataURL(file);
  });
}
function toText(file) {
  return new Promise((res,rej) => {
    const r = new FileReader();
    r.onload = e => res(e.target.result);
    r.onerror = rej;
    r.readAsText(file);
  });
}

/* ═══════════════════════════════════════
   EXTRACTION WORKFLOW
═══════════════════════════════════════ */
async function startExtract() {
  if (!S.files.length) { toast('warn','No Files','Upload at least one document.'); return; }
  showOverlay('brain','Starting Extraction','Preparing your documents for AI analysis...', EXT_STAGES);
  activateStep(1);
  S.files.forEach((_,i) => setFStatus(i,'b-proc','⏳ Processing...'));

  try {
    if (S.mode === 'backend') await extractBackend();
    else if (S.mode === 'vision') await extractVision();
    else await extractLocal();
  } catch(e) {
    hideOverlay();
    log('Extraction error: ' + e.message, 'err');
    toast('err','Extraction Failed', e.message);
    S.files.forEach((_,i) => setFStatus(i,'b-ready','✓ Ready'));
    activateStep(0);
  }
}

/* ─── Backend Mode ─── */
async function extractBackend() {
  const url = document.getElementById('apiUrl').value.trim();
  setStage(0, EXT_STAGES); setProgress(8,'Uploading files...');
  const fd = new FormData();
  S.files.forEach(f => fd.append('files', f));
  setStage(1, EXT_STAGES); setProgress(20,'Server processing...');
  const res = await fetch(url, {method:'POST', body:fd});
  setStage(2, EXT_STAGES); setProgress(40,'Reading response...');
  if (!res.ok) throw new Error(`Backend HTTP ${res.status}`);
  const data = await res.json();
  setStage(3, EXT_STAGES); setProgress(65,'Mapping fields...');
  if (!data.success) throw new Error(data.error || 'Backend failed');
  setStage(4, EXT_STAGES); setProgress(82,'Populating form...');
  await sleep(400);
  setStage(5, EXT_STAGES); setProgress(97,'Finalizing...');
  await sleep(300);
  S.extractedData = data.data;
  S.rawText = data.raw_text_preview || '';
  populateForm(data.data, data.file_summaries||[]);
  S.files.forEach((_,i) => setFStatus(i,'b-done','✓ Extracted'));
  setProgress(100,'Complete!');
  await sleep(500);
  afterExtract(data.total_chars_extracted||0, data.file_summaries||[]);
}

/* ─── Vision Mode ─── */
async function extractVision() {
  let allText = ''; const summaries = [];
  for (let i = 0; i < S.files.length; i++) {
    const f = S.files[i];
    const ext = f.name.toLowerCase().split('.').pop();
    setStage(0, EXT_STAGES); setProgress(5,'Uploading '+f.name+'...'); await sleep(200);
    setStage(1, EXT_STAGES); setProgress(12,'Detecting document type...'); await sleep(180);
    setStage(2, EXT_STAGES); setProgress(22,'Rendering for OCR...'); await sleep(200);
    try {
      let text = '';
      if (['png','jpg','jpeg'].includes(ext)) {
        setStage(3, EXT_STAGES); setProgress(38,'Sending to Google Vision API...');
        const b64 = await toB64(f);
        text = await visionOCR(b64);
        summaries.push({name:f.name,type:'Image',chars:text.length,status:'done'});
        log(`Vision OCR: ${text.length} chars from ${f.name}`,'ok');
      } else if (ext === 'pdf') {
        setStage(3, EXT_STAGES); setProgress(38,'Sending PDF to Vision API...');
        const b64 = await toB64(f);
        text = await visionOCR(b64);
        summaries.push({name:f.name,type:'PDF',chars:text.length,status:text.length>0?'done':'empty'});
        log(`Vision PDF: ${text.length} chars`,'ok');
      } else if (['txt','csv'].includes(ext)) {
        text = await toText(f);
        summaries.push({name:f.name,type:'Text',chars:text.length,status:'done'});
      } else {
        throw new Error("Unsupported format for Vision OCR. Use PDF or Images.");
      }
      allText += `\n--- ${f.name} ---\n${text}\n`;
      setFStatus(i,'b-done','✓ Extracted');
    } catch(ve) {
      log(`Vision API failed for ${f.name}: ${ve.message}. Switching to local browser parser...`,'warn');
      toast('warn','Vision API Failed','Attempting local browser-based OCR/text fallback...');
      try {
        let text = '';
        if (['png','jpg','jpeg'].includes(ext)) {
          text = await ocrImageClient(f);
          summaries.push({name:f.name,type:'Image (Local OCR)',chars:text.length,status:'done'});
        } else if (ext === 'pdf') {
          // Try text extraction first
          text = await parsePdfClient(f);
          if (text.trim().length < 40) {
            text = await parsePdfOcrClient(f);
            summaries.push({name:f.name,type:'PDF (Scanned - Local OCR)',chars:text.length,status:'done'});
          } else {
            summaries.push({name:f.name,type:'PDF (Text - Local)',chars:text.length,status:'done'});
          }
        } else if (['txt','csv'].includes(ext)) {
          text = await toText(f);
          summaries.push({name:f.name,type:'Text',chars:text.length,status:'done'});
        }
        allText += `\n--- ${f.name} ---\n${text}\n`;
        setFStatus(i,'b-done','✓ Parsed (Local)');
        log(`Local browser fallback successful for ${f.name} (${text.length} chars).`,'ok');
      } catch(le) {
        log(`Local browser fallback failed for ${f.name}: ${le.message}`,'err');
        setFStatus(i,'b-err','❌ Failed');
        summaries.push({name:f.name,type:'Failed',chars:0,status:'failed'});
        toast('err','Vision OCR Failed',`Could not extract text from ${f.name}: ${ve.message}. Local fallback also failed: ${le.message}`);
      }
    }
    setProgress(40 + ((i+1)/S.files.length)*45, 'Parsing text...');
  }
  setStage(4, EXT_STAGES); setProgress(88,'Mapping financial data...'); await sleep(400);
  const parsed = parseFinancials(allText);
  S.extractedData = parsed; S.rawText = allText;
  setStage(5, EXT_STAGES); setProgress(97,'Finalizing...'); await sleep(300);
  populateForm(parsed, summaries);
  setProgress(100,'Complete!'); await sleep(500);
  afterExtract(allText.length, summaries);
}

/* ─── Local/Offline Mode ─── */
/* ─── Client-Side Document Parsers (Free / No Billing) ─── */
async function parsePdfClient(file) {
  try {
    const arrayBuffer = await file.arrayBuffer();
    pdfjsLib.GlobalWorkerOptions.workerSrc = 'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.4.120/pdf.worker.min.js';
    const pdf = await pdfjsLib.getDocument({ data: arrayBuffer }).promise;
    let fullText = '';
    const numPages = Math.min(pdf.numPages, 10);
    for (let i = 1; i <= numPages; i++) {
      const page = await pdf.getPage(i);
      const textContent = await page.getTextContent();
      const pageText = textContent.items.map(item => item.str).join(' ');
      fullText += `\n[Page ${i}]\n${pageText}\n`;
    }
    return fullText;
  } catch(e) {
    throw new Error('PDF reader failed: ' + e.message);
  }
}

async function parsePdfOcrClient(file) {
  try {
    const arrayBuffer = await file.arrayBuffer();
    pdfjsLib.GlobalWorkerOptions.workerSrc = 'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.4.120/pdf.worker.min.js';
    const pdf = await pdfjsLib.getDocument({ data: arrayBuffer }).promise;
    let fullText = '';
    const numPages = Math.min(pdf.numPages, 3); // OCR max 3 pages client-side to be fast
    for (let i = 1; i <= numPages; i++) {
      const page = await pdf.getPage(i);
      const viewport = page.getViewport({ scale: 1.5 });
      const canvas = document.createElement('canvas');
      const context = canvas.getContext('2d');
      canvas.height = viewport.height;
      canvas.width = viewport.width;
      
      await page.render({ canvasContext: context, viewport: viewport }).promise;
      const dataUrl = canvas.toDataURL('image/jpeg');
      
      log(`Running local OCR on PDF page ${i}...`,'inf');
      const text = await ocrImageClient(dataUrl);
      fullText += `\n[Page ${i} OCR]\n${text}\n`;
    }
    return fullText;
  } catch(e) {
    throw new Error('PDF Canvas OCR failed: ' + e.message);
  }
}

async function parseExcelClient(file) {
  try {
    const arrayBuffer = await file.arrayBuffer();
    const workbook = XLSX.read(arrayBuffer, { type: 'array' });
    let fullText = '';
    workbook.SheetNames.forEach(sheetName => {
      const worksheet = workbook.Sheets[sheetName];
      const csv = XLSX.utils.sheet_to_csv(worksheet);
      fullText += `\n[Sheet: ${sheetName}]\n${csv}\n`;
    });
    return fullText;
  } catch(e) {
    throw new Error('Excel parser failed: ' + e.message);
  }
}

async function parseDocxClient(file) {
  try {
    const arrayBuffer = await file.arrayBuffer();
    const result = await mammoth.extractRawText({ arrayBuffer: arrayBuffer });
    return result.value;
  } catch(e) {
    throw new Error('Word parser failed: ' + e.message);
  }
}

async function ocrImageClient(fileOrUrl) {
  try {
    const res = await Tesseract.recognize(fileOrUrl, 'eng');
    return res.data.text;
  } catch(e) {
    throw new Error('Image OCR failed: ' + e.message);
  }
}

/* ─── Client-Side/Offline Extraction Mode ─── */
async function extractLocal() {
  let allText = ''; const summaries = [];
  for (let i = 0; i < S.files.length; i++) {
    const f = S.files[i];
    const ext = f.name.toLowerCase().split('.').pop();
    setStage(0, EXT_STAGES); setProgress(10, 'Reading ' + f.name + '...');
    let text = '';
    try {
      if (['txt', 'csv'].includes(ext)) {
        setStage(1, EXT_STAGES); setProgress(25, 'Reading text...');
        text = await toText(f);
        summaries.push({name:f.name, type:'Text', chars:text.length, status:'done'});
        setFStatus(i, 'b-done', '✓ Parsed');
      } else if (['xlsx', 'xls'].includes(ext)) {
        setStage(2, EXT_STAGES); setProgress(35, 'Reading spreadsheet...');
        text = await parseExcelClient(f);
        summaries.push({name:f.name, type:'Excel', chars:text.length, status:'done'});
        setFStatus(i, 'b-done', '✓ Parsed');
      } else if (['docx', 'doc'].includes(ext)) {
        setStage(2, EXT_STAGES); setProgress(35, 'Reading Word doc...');
        text = await parseDocxClient(f);
        summaries.push({name:f.name, type:'Word', chars:text.length, status:'done'});
        setFStatus(i, 'b-done', '✓ Parsed');
      } else if (['png', 'jpg', 'jpeg'].includes(ext)) {
        setStage(3, EXT_STAGES); setProgress(45, 'Running browser OCR...');
        text = await ocrImageClient(f);
        summaries.push({name:f.name, type:'Image OCR', chars:text.length, status:'done'});
        setFStatus(i, 'b-done', '✓ OCR Done');
      } else if (ext === 'pdf') {
        setStage(1, EXT_STAGES); setProgress(20, 'Parsing PDF text...');
        text = await parsePdfClient(f);
        if (text.trim().length < 40) {
          log(`PDF contains no embedded text. Running browser-based canvas OCR...`, 'warn');
          setStage(3, EXT_STAGES); setProgress(45, 'Running OCR...');
          text = await parsePdfOcrClient(f);
          summaries.push({name:f.name, type:'PDF (Scanned)', chars:text.length, status:'done'});
          setFStatus(i, 'b-done', '✓ OCR Done');
        } else {
          summaries.push({name:f.name, type:'PDF (Text)', chars:text.length, status:'done'});
          setFStatus(i, 'b-done', '✓ Parsed');
        }
      } else {
        throw new Error('Unsupported file extension: ' + ext);
      }
      allText += `\n--- ${f.name} ---\n${text}\n`;
    } catch(err) {
      log(`Client-side parser failed for ${f.name}: ${err.message}`, 'err');
      setFStatus(i, 'b-err', '❌ Failed');
      summaries.push({name:f.name, type:'Failed', chars:0, status:'failed'});
      toast('err', 'Extraction Failed', `Error parsing ${f.name}: ${err.message}`);
    }
  }
  setStage(4, EXT_STAGES); setProgress(82,'Parsing financial fields...'); await sleep(350);
  const parsed = parseFinancials(allText);
  S.extractedData = parsed; S.rawText = allText;
  setStage(5, EXT_STAGES); setProgress(97,'Finalizing...'); await sleep(300);
  populateForm(parsed, summaries);
  setProgress(100,'Complete!'); await sleep(500);
  afterExtract(allText.length, summaries);
}

function afterExtract(chars, summaries) {
  hideOverlay();
  log(`Extraction complete: ${chars.toLocaleString()} chars from ${S.files.length} file(s)`,'ok');
  // Show extraction banner
  const ban = document.getElementById('extBanner');
  ban.classList.add('show');
  document.getElementById('extBanTitle').textContent = 'AI Extraction Successful';
  document.getElementById('extBanDesc').textContent = `Extracted ${chars.toLocaleString()} characters from ${S.files.length} file(s).`;
  document.getElementById('extFieldCount').textContent = S.extractedFields.length + ' fields auto-filled';
  // Raw text
  document.getElementById('rawPrev').value = S.rawText.slice(0,3000) || 'No text.';
  // Build doc pages
  buildDocPages(summaries);
  toast('ok','Extraction Complete!',`Data extracted from ${S.files.length} file(s). Review and run analysis.`);
  goPage(1); // → Verify
}

/* ═══════════════════════════════════════
   OCR SIMULATOR
═══════════════════════════════════════ */
function simOCR(filename) {
  return `FINANCIAL STATEMENT — ${filename}
Tech Solutions Private Limited | FY 2022-2025

BALANCE SHEET
Current Assets: Rs. 32,50,000
Fixed Assets: Rs. 28,00,000
Current Liabilities: Rs. 15,00,000
Long Term Debt: Rs. 18,00,000
Net Worth: Rs. 22,00,000

PROFIT & LOSS
Revenue 2023: 90,00,000
Revenue 2024: 85,00,000
Revenue 2025: 1,02,00,000
Net Profit 2023: 13,50,000
Net Profit 2024: 12,75,000
Net Profit 2025: 15,30,000
EBITDA 2023: 18,00,000
EBITDA 2024: 17,00,000
EBITDA 2025: 20,40,000

Monthly Income: Rs. 80,000
CIBIL Score: 725
Proposed Loan Amount: Rs. 15,00,000
Proposed EMI: Rs. 18,000
Existing EMI: Rs. 10,000
COGS: Rs. 45,00,000
Operating Expenses: Rs. 28,00,000`;
}

/* ═══════════════════════════════════════
   TEXT → FINANCIALS PARSER
═══════════════════════════════════════ */
function cfloat(v,d=null){ if(v===undefined||v===null||v==='')return d; const n=parseFloat(String(v).replace(/[^\d.\-]/g,'')); return isNaN(n)?d:n; }
function cint(v,d=null){ const cf=cfloat(v,d); return cf===null?null:Math.round(cf); }
function srch(t, pats, d=null){ for(const p of pats){ const m=t.match(p); if(m)return m[1]; } return d; }

function parseFinancials(text) {
  const tl = text.toLowerCase();
  const d = {};

  // 1. Business type
  if (/public limited|motors limited|steel limited|industries limited/i.test(text)) d.businessType = 'Public Limited';
  else if (/private limited|pvt\.?\s*ltd/i.test(text)) d.businessType = 'Private Limited';
  else if (/\bllp\b|limited liability partnership/i.test(text)) d.businessType = 'LLP';
  else if (/\bpartnership\b/i.test(text)) d.businessType = 'Partnership';
  else {
    if (/private/i.test(text)) d.businessType = 'Private Limited';
    else if (/limited/i.test(text)) d.businessType = 'Public Limited';
    else d.businessType = 'Private Limited';
  }

  // 2. Nature of Business
  if (/manufactur|factory|plant|chemical|steel|industrial|motors|automotive/i.test(text)) d.natureOfBusiness = 'Manufacturing';
  else if (/it services|software|technology|consulting|systems|infotech|digital/i.test(text)) d.natureOfBusiness = 'IT Services';
  else if (/hospital|health|medical|clinic|pharma|diagnostics/i.test(text)) d.natureOfBusiness = 'Healthcare';
  else if (/construct|builder|cement|infrastructure|real estate|developers/i.test(text)) d.natureOfBusiness = 'Construction';
  else if (/trade|trading|distributor|wholesale|supply chain/i.test(text)) d.natureOfBusiness = 'Trading';
  else d.natureOfBusiness = 'Manufacturing';

  // Helper functions
  function cleanFloat(val) {
    if (val === undefined || val === null) return null;
    let valStr = String(val).trim();
    let isNegative = false;
    if ((valStr.startsWith('(') && valStr.endsWith(')')) || (valStr.startsWith('[') && valStr.endsWith(']'))) {
      isNegative = true;
    }
    valStr = valStr.replace(/[\(\)\[\]]/g, '');
    
    if (valStr.includes(',') && !valStr.includes('.')) {
      let parts = valStr.split(',');
      if (parts.length === 2 && parts[1].length === 2) {
        valStr = valStr.replace(',', '.');
      }
    }
    let cleaned = valStr.replace(/[^\d\.\-]/g, '');
    if (!cleaned) return null;
    let num = parseFloat(cleaned);
    return isNegative ? -num : num;
  }

  function cleanInt(val) {
    let cf = cleanFloat(val);
    return cf === null ? null : Math.round(cf);
  }

  function srch(txt, patterns) {
    for (let pattern of patterns) {
      let match = txt.match(pattern);
      if (match && match[1]) return match[1];
    }
    return null;
  }

  d.cibil = cleanInt(srch(text, [/(?:cibil|credit score|cibil[\s\-]+score)[\s:]+([3-9]\d{2})/i, /score[\s:]+([3-9]\d{2})/i]));
  d.proposedLoan = cleanFloat(srch(text, [/(?:proposed loan|loan amount|requested loan|sanctioned amount)[\s:]+(?:rs\.?|inr|₹)?[\s,]*([\d,]+(?:\.\d+)?)/i, /loan value[\s:]+(?:rs\.?|inr|₹)?[\s,]*([\d,]+)/i]));
  d.proposedEMI = cleanFloat(srch(text, [/(?:proposed emi|emi amount|expected emi|monthly installment)[\s:]+(?:rs\.?|inr|₹)?[\s,]*([\d,]+(?:\.\d+)?)/i]));
  d.monthlyIncome = cleanFloat(srch(text, [/(?:monthly income|avg monthly income|monthly salary|monthly earnings)[\s:]+(?:rs\.?|inr|₹)?[\s,]*([\d,]+(?:\.\d+)?)/i]));
  d.existingEMI = cleanFloat(srch(text, [/(?:existing emi|current emi|other emi|existing obligations)[\s:]+(?:rs\.?|inr|₹)?[\s,]*([\d,]+(?:\.\d+)?)/i]));

  // Balance sheet section parser
  const lines = text.split('\n');
  let bsLines = [];
  let inBs = false;
  for (let line of lines) {
    if (/assets and liabilities|assets & liabilities|balance sheet/i.test(line)) {
      inBs = true;
    }
    if (inBs) {
      bsLines.push(line);
    }
    if (inBs && /total equity and liabilities/i.test(line)) {
      let idxTemp = lines.indexOf(line);
      for (let j = idxTemp + 1; j <= idxTemp + 5 && j < lines.length; j++) {
        bsLines.push(lines[j]);
      }
      break;
    }
  }
  if (bsLines.length === 0) bsLines = lines;

  let currentAssets = null, fixedAssets = null, currentLiabilities = null, longTermDebt = null, equity = null;

  for (let i = 0; i < bsLines.length; i++) {
    let lineClean = bsLines[i].trim();

    // 1. Current Assets
    if (/\(2\)\s*Current\s*assets/i.test(lineClean)) {
      for (let j = i + 1; j < i + 16 && j < bsLines.length; j++) {
        let subClean = bsLines[j].trim();
        let nums = subClean.match(/[\d,]+\.\d{2}/g);
        let words = subClean.match(/[a-zA-Z]/g);
        if (nums && nums.length >= 1 && (!words || words.length === 0)) {
          currentAssets = cleanFloat(nums[0]);
          break;
        }
        if (/total/i.test(subClean) && /current/i.test(subClean) && /assets/i.test(subClean)) {
          if (nums && nums.length >= 1) {
            currentAssets = cleanFloat(nums[0]);
            break;
          }
        }
      }
    }

    // 2. Fixed Assets
    if (/property,\s*plant\s*and\s*equipment|fixed\s*assets/i.test(lineClean)) {
      let nums = lineClean.match(/[\d,]+\.\d{2}/g);
      if (nums && nums.length >= 1) fixedAssets = cleanFloat(nums[0]);
    }

    // 3. Current Liabilities
    if (/\(2\)\s*Current\s*liabilities/i.test(lineClean)) {
      for (let j = i + 1; j < i + 20 && j < bsLines.length; j++) {
        let subClean = bsLines[j].trim();
        let nums = subClean.match(/[\d,]+\.\d{2}/g);
        let words = subClean.match(/[a-zA-Z]/g);
        if (nums && nums.length >= 1 && (!words || words.length === 0) && !/total|equity|assets/i.test(subClean)) {
          currentLiabilities = cleanFloat(nums[0]);
          break;
        }
      }
    }

    // 4. Long Term Debt
    if (/\(1\}\s*Non-current\s*liabilities|\(1\)\s*Non-current\s*liabilities|\{1\}\s*Non-current\s*liabilities/i.test(lineClean)) {
      for (let j = i + 1; j < i + 10 && j < bsLines.length; j++) {
        let subClean = bsLines[j].trim();
        if (/borrowings/i.test(subClean)) {
          let nums = subClean.match(/[\d,]+\.\d{2}/g);
          if (nums && nums.length >= 1) {
            longTermDebt = cleanFloat(nums[0]);
            break;
          }
        }
      }
      if (!longTermDebt) {
        for (let j = i + 1; j < i + 15 && j < bsLines.length; j++) {
          let subClean = bsLines[j].trim();
          let nums = subClean.match(/[\d,]+\.\d{2}/g);
          let words = subClean.match(/[a-zA-Z]/g);
          if (nums && nums.length >= 1 && (!words || words.length === 0)) {
            longTermDebt = cleanFloat(nums[0]);
            break;
          }
        }
      }
    }

    // 5. Equity / Net Worth
    if (/net worth/i.test(lineClean) && !/ratio|margin|turnover/i.test(lineClean)) {
      let nums = lineClean.match(/[\d,]+\.\d{2}/g);
      if (nums && nums.length >= 1) equity = cleanFloat(nums[0]);
    } else if (/total equity/i.test(lineClean) && !/liabilities/i.test(lineClean)) {
      let nums = lineClean.match(/[\d,]+\.\d{2}/g);
      if (nums && nums.length >= 1) equity = cleanFloat(nums[0]);
    }
  }

  // Fallbacks
  if (!currentAssets) currentAssets = cleanFloat(srch(text, [/(?<!non-)(?<!non\s)(?<!other\s)current\s+assets\s*[:\s]*(?:rs\.?|inr|₹)?[\s,]*([\d,]+(?:\.\d+)?)/i]));
  if (!fixedAssets) fixedAssets = cleanFloat(srch(text, [/(?:fixed assets|net fixed assets|non-current assets)\s*[:\s]*(?:rs\.?|inr|₹)?[\s,]*([\d,]+(?:\.\d+)?)/i]));
  if (!currentLiabilities) currentLiabilities = cleanFloat(srch(text, [/(?<!non-)(?<!non\s)(?<!other\s)current\s+liabilities\s*[:\s]*(?:rs\.?|inr|₹)?[\s,]*([\d,]+(?:\.\d+)?)/i]));
  if (!longTermDebt) longTermDebt = cleanFloat(srch(text, [/(?:long-term debt|secured loans|non-current liabilities)\s*[:\s]*(?:rs\.?|inr|₹)?[\s,]*([\d,]+(?:\.\d+)?)/i]));
  if (!equity) {
    equity = cleanFloat(srch(text, [
      /net\s*worth\b.*?\b([\d,]+\.\d{2})/i,
      /total\s*equity\b.*?\b([\d,]+\.\d{2})/i,
      /net\s*worth\s*(?:in\s*crores)?\??\s*([\d,]+\.\d{2})/i,
      /total\s*equity\s*[:\s]*([\d,]+(?:\.\d+)?)/i
    ]));
  }

  let inventory = null;
  for (let i = 0; i < bsLines.length; i++) {
    let lineClean = bsLines[i].trim();
    if (/inventories|inventory|stock-in-trade|stock in trade/i.test(lineClean)) {
      let nums = lineClean.match(/[\d,]+\.\d{2}/g);
      if (nums && nums.length >= 1) {
        inventory = cleanFloat(nums[0]);
        break;
      }
    }
  }
  if (!inventory) {
    inventory = cleanFloat(srch(text, [/(?:inventories|inventory|stock\-in\-trade|stock in trade)\s*[:\s]*(?:rs\.?|inr|₹)?[\s,]*([\d,]+(?:\.\d+)?)/i]));
  }
  if (!inventory) inventory = 0;

  d.currentAssets = currentAssets;
  d.inventory = inventory;
  d.fixedAssets = fixedAssets;
  d.currentLiabilities = currentLiabilities;
  d.longTermDebt = longTermDebt;
  d.equity = equity;

  d.cogs = cleanFloat(srch(text, [
    /cost\s*of\s*materials\s*consumed\s+([\d,]+\.\d{2})/i,
    /(?:cogs|cost of goods sold)[\s:]+(?:rs\.?|inr|₹)?[\s,]*([\d,]+(?:\.\d+)?)/i
  ]));
  d.opex = cleanFloat(srch(text, [
    /other\s*expenses\s+([\d,]+\.\d{2})/i,
    /(?:opex|operating expenses|administrative)[\s:]+(?:rs\.?|inr|₹)?[\s,]*([\d,]+(?:\.\d+)?)/i
  ]));

// Multi-year P&L Detection
  let yearsDetected = [];
  let yearHeaderIdx = -1;
  for (let i = 0; i < Math.min(lines.length, 50); i++) {
    let matches = lines[i].match(/\b(20[1-2]\d|FY[1-2]\d)\b/gi);
    if (matches && matches.length >= 2) {
      let cleaned = matches.map(m => {
        if (m.toUpperCase().startsWith('FY')) return parseInt(m.substring(2)) + 2000;
        return parseInt(m);
      });
      yearsDetected = Array.from(new Set(cleaned)).sort((a,b)=>a-b);
      yearHeaderIdx = i;
      break;
    }
  }
  if (yearsDetected.length === 0) yearsDetected = [2022, 2023];

  let yearMap = {};
  yearsDetected.forEach(yr => {
    yearMap[yr] = { revenue: null, netProfit: null, ebitda: null, ocf: null };
  });

  // Extract year columns positions from header
  let yearTokens = [];
  if (yearHeaderIdx !== -1) {
    let headerLine = lines[yearHeaderIdx];
    let tokens = headerLine.trim().split(/\s+/);
    for (let token of tokens) {
      let m = token.match(/(20[1-2]\d|FY[1-2]\d)/i);
      if (m) {
        let yrVal = m[1].toUpperCase().startsWith('FY') ? parseInt(m[1].substring(2)) + 2000 : parseInt(m[1]);
        yearTokens.push(yrVal);
      }
    }
  }
  if (yearTokens.length === 0) {
    yearTokens = [...yearsDetected].sort((a,b)=>b-a);
  }

  // Heuristic mapping function for clean P&L column alignment
  function mapNumsToYears(parsedNums, key) {
    if (parsedNums.length === yearTokens.length) {
      for (let idx = 0; idx < yearTokens.length; idx++) {
        let yr = yearTokens[idx];
        if (yearMap[yr] !== undefined) {
          yearMap[yr][key] = parsedNums[idx];
        }
      }
    } else if (parsedNums.length === yearsDetected.length) {
      let sortedDesc = [...yearsDetected].sort((a,b)=>b-a);
      for (let idx = 0; idx < sortedDesc.length; idx++) {
        let yr = sortedDesc[idx];
        if (yearMap[yr] !== undefined) {
          yearMap[yr][key] = parsedNums[idx];
        }
      }
    } else if (parsedNums.length >= yearTokens.length) {
      let offset = parsedNums.length - yearTokens.length;
      for (let idx = 0; idx < yearTokens.length; idx++) {
        let yr = yearTokens[idx];
        if (yearMap[yr] !== undefined) {
          yearMap[yr][key] = parsedNums[offset + idx];
        }
      }
    } else if (parsedNums.length >= 2) {
      let sortedDesc = [...yearsDetected].sort((a,b)=>b-a);
      for (let idx = 0; idx < sortedDesc.length; idx++) {
        let yr = sortedDesc[idx];
        if (idx < parsedNums.length && yearMap[yr] !== undefined) {
          yearMap[yr][key] = parsedNums[idx];
        }
      }
    }
  }

  // Highly robust, OCR-resilient row matching rules with dynamic mapping
  for (let line of lines) {
    let lineClean = line.trim();
    if (!lineClean) continue;
    let nums = lineClean.match(/[\d,]+\.\d{2}|\([\d,]+\.\d{2}\)|\[[\d,]+\.\d{2}\]/g);
    if (!nums || nums.length < 2) continue;
    let parsedNums = nums.map(n => cleanFloat(n)).filter(n => n !== null && Math.abs(n) > 10.0);
    if (parsedNums.length < 2) continue;

    // 1. Revenue
    if (/revenue from operations|total revenue from operations|turnover|sales/i.test(lineClean)) {
      if (!/other|margin/i.test(lineClean) && !lineClean.includes('%')) {
        mapNumsToYears(parsedNums, 'revenue');
      }
    }

    // 2. Net Profit
    if (/profit|profitiloss|profit\/loss|profit{loss/i.test(lineClean)) {
      if (/period|year|yaar|periad|after tax|pat/i.test(lineClean) && !/before|discontinued|continuing operations|exceptional/i.test(lineClean)) {
        mapNumsToYears(parsedNums, 'netProfit');
      }
    }

    // 3. OCF
    if (/cash/i.test(lineClean) && (/operating/i.test(lineClean) || /operations/i.test(lineClean))) {
      if (/activities|activitles|generated/i.test(lineClean)) {
        mapNumsToYears(parsedNums, 'ocf');
      }
    }
  }

  // Calculate EBITDA
  yearsDetected.forEach(yr => {
    if (yearMap[yr].ebitda === null) {
      let pbt = null, finance = null, depr = null;
      for (let line of lines) {
        let nums = line.match(/[\d,]+\.\d{2}|\([\d,]+\.\d{2}\)|\[[\d,]+\.\d{2}\]/g);
        if (!nums) continue;
        let parsedNums = nums.map(n => cleanFloat(n)).filter(n => n !== null && Math.abs(n) > 10.0);

        // Align values
        let valYr = null;
        if (parsedNums.length === yearTokens.length) {
          for (let idxYr = 0; idxYr < yearTokens.length; idxYr++) {
            if (yearTokens[idxYr] === yr) valYr = parsedNums[idxYr];
          }
        } else if (parsedNums.length === yearsDetected.length) {
          let sortedDesc = [...yearsDetected].sort((a,b)=>b-a);
          for (let idxYr = 0; idxYr < sortedDesc.length; idxYr++) {
            if (sortedDesc[idxYr] === yr) valYr = parsedNums[idxYr];
          }
        } else if (parsedNums.length >= yearTokens.length) {
          let offset = parsedNums.length - yearTokens.length;
          for (let idxYr = 0; idxYr < yearTokens.length; idxYr++) {
            if (yearTokens[idxYr] === yr) valYr = parsedNums[offset + idxYr];
          }
        } else if (parsedNums.length >= 2) {
          let sortedDesc = [...yearsDetected].sort((a,b)=>b-a);
          for (let idxYr = 0; idxYr < sortedDesc.length; idxYr++) {
            if (sortedDesc[idxYr] === yr && idxYr < parsedNums.length) valYr = parsedNums[idxYr];
          }
        }

        if (valYr !== null) {
          if (/profit/i.test(line) && /before/i.test(line) && /tax/i.test(line) && /exceptional/i.test(line)) {
            pbt = valYr;
          }
          else if (/finance costs/i.test(line)) {
            finance = valYr;
          }
          else if (/depreciation/i.test(line) && /amort/i.test(line)) {
            depr = valYr;
          }
        }
      }
      if (pbt !== null && finance !== null && depr !== null) {
        yearMap[yr].ebitda = pbt + finance + depr;
      }
    }
  });

  const sortedYears = yearsDetected.sort((a,b)=>a-b);
  const y3Yr = sortedYears[sortedYears.length-1] || null;
  const y2Yr = sortedYears[sortedYears.length-2] || null;
  const y1Yr = sortedYears[sortedYears.length-3] || null;

  d.y3 = y3Yr ? yearMap[y3Yr] : {revenue:null,netProfit:null,ebitda:null,ocf:null};
  d.y2 = y2Yr ? yearMap[y2Yr] : {revenue:null,netProfit:null,ebitda:null,ocf:null};
  d.y1 = y1Yr ? yearMap[y1Yr] : {revenue:null,netProfit:null,ebitda:null,ocf:null};

  return d;
}

/* ═══════════════════════════════════════
   FORM POPULATION + HIGHLIGHTING
═══════════════════════════════════════ */
const FIELD_MAP = {
  'inputBusinessType':       {id:'lb-businessType'},
  'inputNatureOfBusiness':   {id:'lb-natureOfBusiness'},
  'inputCibil':              {id:'lb-cibil'},
  'inputProposedLoan':       {id:'lb-proposedLoan'},
  'inputProposedEMI':        {id:'lb-proposedEMI'},
  'inputMonthlyIncome':      {id:'lb-monthlyIncome'},
  'inputExistingEMI':        {id:'lb-existingEMI'},
  'inputCurrentAssets':      {id:'lb-currentAssets'},
  'inputInventory':          {id:'lb-inventory'},
  'inputFixedAssets':        {id:'lb-fixedAssets'},
  'inputCurrentLiabilities': {id:'lb-currentLiabilities'},
  'inputLongTermDebt':       {id:'lb-longTermDebt'},
  'inputEquity':             {id:'lb-equity'},
  'inputY1Revenue':          {id:'lb-Y1Revenue'},
  'inputY1NetProfit':        {id:'lb-Y1NetProfit'},
  'inputY1Ebitda':           {id:'lb-Y1Ebitda'},
  'inputY1Ocf':              {id:'lb-Y1Ocf'},
  'inputY2Revenue':          {},
  'inputY2NetProfit':        {},
  'inputY2Ebitda':           {},
  'inputY2Ocf':              {},
  'inputY3Revenue':          {},
  'inputY3NetProfit':        {},
  'inputY3Ebitda':           {},
  'inputY3Ocf':              {},
};

function populateForm(data, summaries) {
  // Clear old highlights
  S.extractedFields.forEach(id => {
    const el = document.getElementById(id);
    if (el) el.classList.remove('ext');
    const lbl = document.getElementById(FIELD_MAP[id]?.id);
    if (lbl) { const b=lbl.querySelector('.ai-badge'); if(b)b.remove(); }
  });
  S.extractedFields = [];

  // Reset all fields to empty string
  Object.keys(FIELD_MAP).forEach(id => {
    const el = document.getElementById(id);
    if (el) el.value = "";
  });

  const VALUES = {
    inputBusinessType: data.businessType,
    inputNatureOfBusiness: data.natureOfBusiness,
    inputCibil: data.cibil,
    inputProposedLoan: data.proposedLoan,
    inputProposedEMI: data.proposedEMI,
    inputMonthlyIncome: data.monthlyIncome,
    inputExistingEMI: data.existingEMI,
    inputCurrentAssets: data.currentAssets,
    inputInventory: data.inventory,
    inputFixedAssets: data.fixedAssets,
    inputCurrentLiabilities: data.currentLiabilities,
    inputLongTermDebt: data.longTermDebt,
    inputEquity: data.equity,
    inputY1Revenue: data.y1?.revenue,
    inputY1NetProfit: data.y1?.netProfit,
    inputY1Ebitda: data.y1?.ebitda,
    inputY1Ocf: data.y1?.ocf,
    inputY2Revenue: data.y2?.revenue,
    inputY2NetProfit: data.y2?.netProfit,
    inputY2Ebitda: data.y2?.ebitda,
    inputY2Ocf: data.y2?.ocf,
    inputY3Revenue: data.y3?.revenue,
    inputY3NetProfit: data.y3?.netProfit,
    inputY3Ebitda: data.y3?.ebitda,
    inputY3Ocf: data.y3?.ocf,
  };

  for (const [id, val] of Object.entries(VALUES)) {
    if (val === undefined || val === null) continue;
    const el = document.getElementById(id);
    if (!el) continue;
    el.value = val;
    el.classList.add('ext');
    S.extractedFields.push(id);
    // Add AI badge to label
    const lblId = FIELD_MAP[id]?.id;
    if (lblId) {
      const lbl = document.getElementById(lblId);
      if (lbl && !lbl.querySelector('.ai-badge')) {
        const b = document.createElement('span');
        b.className = 'ai-badge';
        b.innerHTML = '<i class="fas fa-robot" style="font-size:.62rem;"></i> AI';
        lbl.appendChild(b);
      }
    }
  }
  buildDocPages(summaries);
  log(`Populated ${S.extractedFields.length} fields from extraction.`,'ok');
}

function buildDocPages(summaries) {
  if (!summaries?.length) return;
  document.getElementById('dpList').innerHTML = summaries.map((s,i) => `
    <div class="dp-thumb ${i===0?'active':''}" onclick="document.querySelectorAll('.dp-thumb').forEach(e=>e.classList.remove('active'));this.classList.add('active');">
      <div class="dp-num">${i+1}</div>
      <div class="dp-inf">
        <div class="dp-n">${s.name||'File '+(i+1)}</div>
        <div class="dp-c">${(s.chars||0).toLocaleString()} chars · ${s.type||'Doc'}</div>
      </div>
      <i class="fas fa-${s.status==='done'?'check-circle" style="color:var(--ok)':'exclamation-circle" style="color:var(--warn)'}"></i>
    </div>`).join('');
}

/* ═══════════════════════════════════════
   ANALYSIS ENGINE
═══════════════════════════════════════ */
async function runAnalysis() {
  showOverlay('calculator','Running Credit Analysis','Computing financial ratios, credit score, and recommendation...', ANA_STAGES);
  activateStep(4);

  // Collect form values
  const D = {
    cibil: +document.getElementById('inputCibil').value||0,
    proposedLoan: +document.getElementById('inputProposedLoan').value||0,
    proposedEMI: +document.getElementById('inputProposedEMI').value||0,
    monthlyIncome: +document.getElementById('inputMonthlyIncome').value||0,
    existingEMI: +document.getElementById('inputExistingEMI').value||0,
    currentAssets: +document.getElementById('inputCurrentAssets').value||0,
    inventory: +document.getElementById('inputInventory').value||0,
    fixedAssets: +document.getElementById('inputFixedAssets').value||0,
    currentLiabilities: +document.getElementById('inputCurrentLiabilities').value||0,
    longTermDebt: +document.getElementById('inputLongTermDebt').value||0,
    equity: +document.getElementById('inputEquity').value||0,
    y1:{revenue:+document.getElementById('inputY1Revenue').value||0,netProfit:+document.getElementById('inputY1NetProfit').value||0,ebitda:+document.getElementById('inputY1Ebitda').value||0,ocf:+document.getElementById('inputY1Ocf').value||0},
    y2:{revenue:+document.getElementById('inputY2Revenue').value||0,netProfit:+document.getElementById('inputY2NetProfit').value||0,ebitda:+document.getElementById('inputY2Ebitda').value||0,ocf:+document.getElementById('inputY2Ocf').value||0},
    y3:{revenue:+document.getElementById('inputY3Revenue').value||0,netProfit:+document.getElementById('inputY3NetProfit').value||0,ebitda:+document.getElementById('inputY3Ebitda').value||0,ocf:+document.getElementById('inputY3Ocf').value||0},
  };

  // Animate stages
  for (let i = 0; i < ANA_STAGES.length; i++) {
    setStage(i, ANA_STAGES);
    setProgress((i+1)/ANA_STAGES.length*100, ANA_STAGES[i].t);
    await sleep(680);
  }

  const R = compute(D);
  S.analysis = R;
  setProgress(100,'Done!');
  await sleep(500);
  hideOverlay();
  renderResults(D, R);
  goPage(2);
  toast('ok','Analysis Complete!','Credit score and recommendation ready.');
  log('Credit analysis completed.','ok');
}

function compute(D) {
  const R = {};
  R.currentRatio = D.currentAssets / (D.currentLiabilities||1);
  R.quickRatio = (D.currentAssets - (D.inventory||0)) / (D.currentLiabilities||1);
  const totalDebt = (D.currentLiabilities||0) + (D.longTermDebt||0);
  R.deRatio = totalDebt / (D.equity||1);
  R.daRatio = totalDebt / ((D.currentAssets+D.fixedAssets)||1);
  R.icRatio = D.y3.ebitda / (D.y3.revenue*0.02||100000);
  R.netMargin = (D.y3.netProfit/(D.y3.revenue||1))*100;
  R.ebitdaMargin = (D.y3.ebitda/(D.y3.revenue||1))*100;
  R.roe = (D.y3.netProfit/(D.equity||1))*100;
  R.roa = (D.y3.netProfit/((D.currentAssets+D.fixedAssets)||1))*100;
  R.foir = ((D.existingEMI+D.proposedEMI)/(D.monthlyIncome||1))*100;
  R.dscr = D.monthlyIncome/((D.existingEMI+D.proposedEMI)||1);
  R.pti = (D.proposedEMI/(D.monthlyIncome||1))*100;
  R.revG12 = ((D.y2.revenue-D.y1.revenue)/(D.y1.revenue||1))*100;
  R.revG23 = ((D.y3.revenue-D.y2.revenue)/(D.y2.revenue||1))*100;

  // Score (100 pts)
  let sc = 0;
  if (D.cibil>=800) sc+=25; else if (D.cibil>=750) sc+=20; else if (D.cibil>=700) sc+=15; else if (D.cibil>=650) sc+=8;
  if (R.foir<=30) sc+=20; else if (R.foir<=40) sc+=15; else if (R.foir<=50) sc+=10; else if (R.foir<=60) sc+=5;
  if (R.currentRatio>=2) sc+=15; else if (R.currentRatio>=1.5) sc+=12; else if (R.currentRatio>=1.2) sc+=8; else if (R.currentRatio>=1) sc+=4;
  if (R.deRatio<=0.5) sc+=15; else if (R.deRatio<=1) sc+=12; else if (R.deRatio<=1.5) sc+=8; else if (R.deRatio<=2) sc+=4;
  if (R.netMargin>=20) sc+=15; else if (R.netMargin>=15) sc+=12; else if (R.netMargin>=10) sc+=8; else if (R.netMargin>=5) sc+=4;
  if (R.revG23>=15) sc+=10; else if (R.revG23>=10) sc+=8; else if (R.revG23>=5) sc+=5; else if (R.revG23>=0) sc+=2;
  R.score = Math.min(100, sc);

  if (sc>=70){ R.rec='ra'; R.recTag='APPROVED'; R.recH='Loan Approved'; R.recP='Strong financial profile. Meets all credit criteria — good CIBIL, manageable leverage, positive revenue trend.'; }
  else if (sc>=50){ R.rec='rr'; R.recTag='CONDITIONAL REVIEW'; R.recH='Manual Review Required'; R.recP='Moderate risk profile. Recommend additional documentation or collateral. Underwriter review advised.'; }
  else { R.rec='rd'; R.recTag='DECLINED'; R.recH='Loan Declined'; R.recP='Profile does not meet minimum credit standards due to weak metrics. Re-apply after improving financial standing.'; }
  return R;
}

/* ═══════════════════════════════════════
   RENDER RESULTS
═══════════════════════════════════════ */
function renderResults(D, R) {
  document.getElementById('navScore').textContent = R.score;
  // KPIs
  setKpi('kScore',   R.score,        '/100', R.score>=70?'ok':R.score>=50?'warn':'bad',  R.score>=70?'Meets criteria':R.score>=50?'Borderline':'Below threshold');
  setKpi('kCR',      R.currentRatio.toFixed(2),'x', R.currentRatio>=1.5?'ok':R.currentRatio>=1?'warn':'bad','Benchmark: ≥ 1.5x');
  setKpi('kFOIR',    R.foir.toFixed(1)+'%','', R.foir<=40?'ok':R.foir<=55?'warn':'bad','Benchmark: ≤ 40%');
  setKpi('kDE',      R.deRatio.toFixed(2),'x', R.deRatio<=1?'ok':R.deRatio<=1.5?'warn':'bad','Benchmark: ≤ 1.0x');
  setKpi('kNM',      R.netMargin.toFixed(1)+'%','', R.netMargin>=15?'ok':R.netMargin>=8?'warn':'bad','Net Margin (Y3)');
  setKpi('kDSCR',    R.dscr.toFixed(2),'x', R.dscr>=1.25?'ok':R.dscr>=1?'warn':'bad','Benchmark: ≥ 1.25x');

  // Score ring
  document.getElementById('scoreBig').textContent = R.score;
  const c = 2*Math.PI*64;
  document.getElementById('scoreRing').style.strokeDashoffset = c - (R.score/100)*c;
  const rb = document.getElementById('riskBadge');
  if (R.score>=70){ rb.style.background='rgba(16,185,129,.15)'; rb.style.color='var(--ok)'; rb.textContent='LOW RISK'; }
  else if (R.score>=50){ rb.style.background='rgba(245,158,11,.15)'; rb.style.color='var(--warn)'; rb.textContent='MEDIUM RISK'; }
  else { rb.style.background='rgba(239,68,68,.15)'; rb.style.color='var(--err)'; rb.textContent='HIGH RISK'; }

  // Recommendation
  const recCard = document.getElementById('recCard');
  recCard.className = 'rec-c '+R.rec;
  const ICONS={ra:'thumbs-up',rr:'exclamation-triangle',rd:'times-circle'};
  document.getElementById('recIco').className='fas fa-'+ICONS[R.rec];
  const CLRS={ra:'var(--ok)',rr:'var(--warn)',rd:'var(--err)'};
  document.getElementById('recTag').textContent=R.recTag; document.getElementById('recTag').style.color=CLRS[R.rec];
  document.getElementById('recH').textContent=R.recH;
  document.getElementById('recP').textContent=R.recP;

  // Ratio grid
  buildRatios(R);
  // Charts
  buildCharts(D);
}

function setKpi(id, val, suf, cls, hint) {
  const v=document.getElementById(id); if(v) v.textContent=val+(suf||'');
  const s=document.getElementById(id+'St');
  if(s){ s.className='kpi-st '+cls; s.innerHTML=`<i class="fas fa-${cls==='ok'?'arrow-up':cls==='bad'?'arrow-down':'minus'}"></i> ${hint}`; }
}

function buildRatios(R) {
  const RATIOS = [
    {n:'Current Ratio',v:R.currentRatio,f:'x',bm:'≥ 1.5',ok:R.currentRatio>=1.5,warn:R.currentRatio>=1.2,pct:Math.min(100,R.currentRatio/2*100)},
    {n:'Quick Ratio',v:R.quickRatio,f:'x',bm:'≥ 1.0',ok:R.quickRatio>=1.0,warn:R.quickRatio>=0.8,pct:Math.min(100,R.quickRatio/1.5*100)},
    {n:'Debt / Equity',v:R.deRatio,f:'x',bm:'≤ 1.0',ok:R.deRatio<=1,warn:R.deRatio<=1.5,pct:Math.max(0,Math.min(100,(1-R.deRatio/3)*100))},
    {n:'Interest Coverage',v:R.icRatio,f:'x',bm:'≥ 3.0',ok:R.icRatio>=3,warn:R.icRatio>=2,pct:Math.min(100,R.icRatio/5*100)},
    {n:'Net Margin (Y3)',v:R.netMargin,f:'%',bm:'≥ 15%',ok:R.netMargin>=15,warn:R.netMargin>=8,pct:Math.min(100,R.netMargin/20*100)},
    {n:'EBITDA Margin',v:R.ebitdaMargin,f:'%',bm:'≥ 20%',ok:R.ebitdaMargin>=20,warn:R.ebitdaMargin>=12,pct:Math.min(100,R.ebitdaMargin/25*100)},
    {n:'ROE',v:R.roe,f:'%',bm:'≥ 15%',ok:R.roe>=15,warn:R.roe>=8,pct:Math.min(100,R.roe/20*100)},
    {n:'FOIR',v:R.foir,f:'%',bm:'≤ 40%',ok:R.foir<=40,warn:R.foir<=55,pct:Math.max(0,Math.min(100,(1-R.foir/100)*100))},
    {n:'DSCR',v:R.dscr,f:'x',bm:'≥ 1.25',ok:R.dscr>=1.25,warn:R.dscr>=1,pct:Math.min(100,R.dscr/2*100)},
    {n:'ROA',v:R.roa,f:'%',bm:'≥ 8%',ok:R.roa>=8,warn:R.roa>=4,pct:Math.min(100,R.roa/12*100)},
    {n:'Rev Growth Y2→Y3',v:R.revG23,f:'%',bm:'≥ 10%',ok:R.revG23>=10,warn:R.revG23>=5,pct:Math.min(100,Math.max(0,(R.revG23+10)/30*100))},
    {n:'PTI',v:R.pti,f:'%',bm:'≤ 25%',ok:R.pti<=25,warn:R.pti<=35,pct:Math.max(0,Math.min(100,(1-R.pti/100)*100))},
  ];
  document.getElementById('ratioGrid').innerHTML = RATIOS.map(r=>{
    const cls=r.ok?'ok':r.warn?'warn':'bad';
    return `<div class="ratio-c">
      <div class="rn">${r.n}</div>
      <div class="rv ${cls}">${r.v.toFixed(2)}${r.f}</div>
      <div class="rb-track"><div class="rb-fill ${cls}" style="width:${Math.max(0,r.pct).toFixed(1)}%"></div></div>
      <div class="rbm">Benchmark: ${r.bm}</div>
    </div>`;
  }).join('');
}

function buildCharts(D) {
  const CFG_AXES = {
    x:{ticks:{color:'#94A3B8'},grid:{color:'rgba(255,255,255,.04)'}},
    y:{ticks:{color:'#94A3B8'},grid:{color:'rgba(255,255,255,.04)'}}
  };
  if(charts.rev)charts.rev.destroy();
  charts.rev = new Chart(document.getElementById('chRev'),{
    type:'bar',
    data:{
      labels:['Year 1','Year 2','Year 3'],
      datasets:[
        {label:'Revenue',data:[D.y1.revenue,D.y2.revenue,D.y3.revenue].map(v=>+(v/1e5).toFixed(1)),backgroundColor:'rgba(99,102,241,.75)',borderRadius:7},
        {label:'Net Profit',data:[D.y1.netProfit,D.y2.netProfit,D.y3.netProfit].map(v=>+(v/1e5).toFixed(1)),backgroundColor:'rgba(16,185,129,.75)',borderRadius:7},
        {label:'EBITDA',data:[D.y1.ebitda,D.y2.ebitda,D.y3.ebitda].map(v=>+(v/1e5).toFixed(1)),backgroundColor:'rgba(245,158,11,.72)',borderRadius:7},
      ]
    },
    options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{labels:{color:'#94A3B8',font:{size:11}}}},scales:{...CFG_AXES,y:{...CFG_AXES.y,ticks:{...CFG_AXES.y.ticks,callback:v=>'₹'+v+'L'}}}}
  });
  if(charts.bal)charts.bal.destroy();
  charts.bal = new Chart(document.getElementById('chBal'),{
    type:'doughnut',
    data:{
      labels:['Current Assets','Fixed Assets','Curr Liabilities','Long-Term Debt','Equity'],
      datasets:[{
        data:[D.currentAssets,D.fixedAssets,D.currentLiabilities,D.longTermDebt,D.equity].map(v=>+(v/1e5).toFixed(1)),
        backgroundColor:['rgba(99,102,241,.82)','rgba(139,92,246,.78)','rgba(239,68,68,.7)','rgba(245,158,11,.7)','rgba(16,185,129,.8)'],
        borderWidth:0,hoverOffset:8
      }]
    },
    options:{responsive:true,maintainAspectRatio:false,cutout:'62%',plugins:{legend:{position:'right',labels:{color:'#94A3B8',font:{size:10},boxWidth:11}}}}
  });
}

/* ═══════════════════════════════════════
   REPORT DOWNLOAD
═══════════════════════════════════════ */
function dlReport(fmt) {
  const R=S.analysis||{}, D=S.extractedData||{};
  if (fmt==='json') {
    const blob=new Blob([JSON.stringify({extractedData:D,analysis:R,generatedAt:new Date().toISOString()},null,2)],{type:'application/json'});
    dl(blob,'credit_analysis.json'); toast('ok','Downloaded','JSON report saved.');
    return;
  }
  if (fmt==='csv') {
    const rows=[
      ['AI Credit Analysis Report'],['Generated',new Date().toLocaleString()],[],
      ['Metric','Value','Benchmark','Status'],
      ['Credit Score',R.score||'—','/100',R.score>=70?'PASS':R.score>=50?'REVIEW':'FAIL'],
      ['Current Ratio',(R.currentRatio||0).toFixed(2)+'x','≥ 1.5x',R.currentRatio>=1.5?'GOOD':'WEAK'],
      ['D/E Ratio',(R.deRatio||0).toFixed(2)+'x','≤ 1.0x',R.deRatio<=1?'GOOD':'WEAK'],
      ['Net Margin',(R.netMargin||0).toFixed(2)+'%','≥ 15%',R.netMargin>=15?'GOOD':'WEAK'],
      ['FOIR',(R.foir||0).toFixed(2)+'%','≤ 40%',R.foir<=40?'GOOD':'WEAK'],
      ['DSCR',(R.dscr||0).toFixed(2)+'x','≥ 1.25x',R.dscr>=1.25?'GOOD':'WEAK'],
      ['EBITDA Margin',(R.ebitdaMargin||0).toFixed(2)+'%','≥ 20%',R.ebitdaMargin>=20?'GOOD':'WEAK'],
      ['ROE',(R.roe||0).toFixed(2)+'%','≥ 15%',R.roe>=15?'GOOD':'WEAK'],
      [],[`Recommendation: ${R.recTag||'—'}`],
    ];
    const blob=new Blob([rows.map(r=>r.join(',')).join('\n')],{type:'text/csv'});
    dl(blob,'credit_analysis.csv'); toast('ok','Downloaded','CSV report saved.');
    return;
  }
  // PDF via print
  const w=window.open('','_blank');
  const pc=R.score>=70?'#D1FAE5':R.score>=50?'#FEF3C7':'#FEE2E2';
  const tc=R.score>=70?'#065F46':R.score>=50?'#92400E':'#991B1B';
  w.document.write(`<html><head><title>Credit Analysis Report</title>
  <style>body{font-family:Arial,sans-serif;padding:40px;color:#111;max-width:1000px;margin:0 auto;}
  h1{color:#4F46E5;border-bottom:3px solid #4F46E5;padding-bottom:10px;margin-bottom:24px;}
  h2{color:#374151;margin-top:28px;margin-bottom:14px;font-size:1.1rem;}
  table{width:100%;border-collapse:collapse;margin:12px 0;}
  th{background:#4F46E5;color:#fff;padding:10px 12px;text-align:left;font-size:.875rem;}
  td{padding:9px 12px;border:1px solid #E5E7EB;font-size:.875rem;}
  tr:nth-child(even) td{background:#F9FAFB;}
  .score{font-size:3.5rem;font-weight:900;color:#4F46E5;}
  .badge{display:inline-block;padding:7px 20px;border-radius:24px;font-weight:800;font-size:.9rem;background:${pc};color:${tc};}
  .good{color:#065F46;font-weight:700;}.weak{color:#991B1B;font-weight:700;}
  </style></head><body>
  <h1>AI Credit Analysis Report</h1>
  <p><strong>Generated:</strong> ${new Date().toLocaleString()}</p>
  <h2>Credit Decision</h2>
  <div class="score">${R.score||'—'}<span style="font-size:1.5rem;color:#9CA3AF;">/100</span></div>
  <p style="margin:10px 0;"><span class="badge">${R.recTag||'—'}</span></p>
  <p style="color:#6B7280;margin-top:8px;">${R.recP||''}</p>
  <h2>Financial Ratios</h2>
  <table><tr><th>Metric</th><th>Value</th><th>Benchmark</th><th>Status</th></tr>
  <tr><td>Current Ratio</td><td>${(R.currentRatio||0).toFixed(2)}x</td><td>≥ 1.5x</td><td class="${R.currentRatio>=1.5?'good':'weak'}">${R.currentRatio>=1.5?'GOOD':'WEAK'}</td></tr>
  <tr><td>Quick Ratio</td><td>${(R.quickRatio||0).toFixed(2)}x</td><td>≥ 1.0x</td><td class="${R.quickRatio>=1.0?'good':'weak'}">${R.quickRatio>=1.0?'GOOD':'WEAK'}</td></tr>
  <tr><td>Debt / Equity</td><td>${(R.deRatio||0).toFixed(2)}x</td><td>≤ 1.0x</td><td class="${R.deRatio<=1?'good':'weak'}">${R.deRatio<=1?'GOOD':'WEAK'}</td></tr>
  <tr><td>Net Margin (Y3)</td><td>${(R.netMargin||0).toFixed(2)}%</td><td>≥ 15%</td><td class="${R.netMargin>=15?'good':'weak'}">${R.netMargin>=15?'GOOD':'WEAK'}</td></tr>
  <tr><td>EBITDA Margin</td><td>${(R.ebitdaMargin||0).toFixed(2)}%</td><td>≥ 20%</td><td class="${R.ebitdaMargin>=20?'good':'weak'}">${R.ebitdaMargin>=20?'GOOD':'WEAK'}</td></tr>
  <tr><td>FOIR</td><td>${(R.foir||0).toFixed(2)}%</td><td>≤ 40%</td><td class="${R.foir<=40?'good':'weak'}">${R.foir<=40?'GOOD':'WEAK'}</td></tr>
  <tr><td>DSCR</td><td>${(R.dscr||0).toFixed(2)}x</td><td>≥ 1.25x</td><td class="${R.dscr>=1.25?'good':'weak'}">${R.dscr>=1.25?'GOOD':'WEAK'}</td></tr>
  <tr><td>ROE</td><td>${(R.roe||0).toFixed(2)}%</td><td>≥ 15%</td><td class="${R.roe>=15?'good':'weak'}">${R.roe>=15?'GOOD':'WEAK'}</td></tr>
  <tr><td>Rev Growth Y2→Y3</td><td>${(R.revG23||0).toFixed(2)}%</td><td>≥ 10%</td><td class="${R.revG23>=10?'good':'weak'}">${R.revG23>=10?'GOOD':'WEAK'}</td></tr>
  </table>
  <h2>Balance Sheet</h2>
  <table><tr><th>Item</th><th>Amount (₹)</th></tr>
  <tr><td>Current Assets</td><td>${(D.currentAssets||0).toLocaleString()}</td></tr>
  <tr><td>Fixed Assets</td><td>${(D.fixedAssets||0).toLocaleString()}</td></tr>
  <tr><td>Current Liabilities</td><td>${(D.currentLiabilities||0).toLocaleString()}</td></tr>
  <tr><td>Long-Term Debt</td><td>${(D.longTermDebt||0).toLocaleString()}</td></tr>
  <tr><td>Equity / Net Worth</td><td>${(D.equity||0).toLocaleString()}</td></tr>
  </table>
  </body></html>`);
  w.document.close();
  setTimeout(()=>w.print(),500);
  toast('info','Print Dialog','Save as PDF from your browser print dialog.');
}

function dl(blob, name){ const u=URL.createObjectURL(blob); const a=document.createElement('a'); a.href=u; a.download=name; a.click(); URL.revokeObjectURL(u); }

function newAnalysis(){
  S.files=[]; S.extractedData=null; S.rawText=''; S.extractedFields=[]; S.analysis=null; S.maxStep=0;
  renderFiles(); document.getElementById('navDocs').textContent='0'; document.getElementById('navScore').textContent='—';
  document.getElementById('btnExtract').disabled=true;
  document.getElementById('extBanner').classList.remove('show');
  document.getElementById('logBox').innerHTML='<div class="log-e"><span class="l-t">[INIT]</span><span class="l-inf"> New analysis started. Upload documents.</span></div>';
  goPage(0); activateStep(0); S.maxStep=0;
}

/* ═══════════════════════════════════════
   TOAST
═══════════════════════════════════════ */
const T_ICO={ok:'fa-check-circle',err:'fa-times-circle',warn:'fa-exclamation-triangle',info:'fa-info-circle'};
function toast(type, title, msg, dur=5000) {
  const c=document.getElementById('toasts');
  const el=document.createElement('div');
  el.className=`toast t-${type}`;
  el.innerHTML=`<div class="t-ico"><i class="fas ${T_ICO[type]}"></i></div>
    <div class="t-body"><div class="t-title">${title}</div><div class="t-msg">${msg}</div></div>
    <button class="t-close" onclick="rmToast(this.parentElement)"><i class="fas fa-times"></i></button>`;
  c.appendChild(el);
  setTimeout(()=>rmToast(el),dur);
}
function rmToast(el){ if(!el)return; el.classList.add('removing'); setTimeout(()=>el.remove(),300); }

/* ═══════════════════════════════════════
   ACTIVITY LOG
═══════════════════════════════════════ */
function log(text, type='inf'){
  const lb=document.getElementById('logBox'); if(!lb)return;
  const t=new Date().toLocaleTimeString('en-IN',{hour12:false});
  const e=document.createElement('div'); e.className='log-e';
  e.innerHTML=`<span class="l-t">[${t}]</span><span class="l-${type}"> ${text}</span>`;
  lb.appendChild(e); lb.scrollTop=lb.scrollHeight;
}

/* ═══════════════════════════════════════
   FINANCIAL REVIEW & TRENDS (NEW)
═══════════════════════════════════════ */
function switchFinTab(tabId, el) {
  el.parentElement.querySelectorAll('.tab-btn').forEach(btn => btn.classList.remove('active'));
  el.classList.add('active');
  const tabContainer = el.closest('.gc');
  tabContainer.querySelectorAll('.tab-content').forEach(c => c.classList.remove('active'));
  tabContainer.querySelector('#' + tabId).classList.add('active');
}

function goFinancials() {
  const D = {
    cibil: +document.getElementById('inputCibil').value||0,
    proposedLoan: +document.getElementById('inputProposedLoan').value||0,
    proposedEMI: +document.getElementById('inputProposedEMI').value||0,
    monthlyIncome: +document.getElementById('inputMonthlyIncome').value||0,
    existingEMI: +document.getElementById('inputExistingEMI').value||0,
    currentAssets: +document.getElementById('inputCurrentAssets').value||0,
    inventory: +document.getElementById('inputInventory').value||0,
    fixedAssets: +document.getElementById('inputFixedAssets').value||0,
    currentLiabilities: +document.getElementById('inputCurrentLiabilities').value||0,
    longTermDebt: +document.getElementById('inputLongTermDebt').value||0,
    equity: +document.getElementById('inputEquity').value||0,
    y1:{
      revenue: +document.getElementById('inputY1Revenue').value||0,
      netProfit: +document.getElementById('inputY1NetProfit').value||0,
      ebitda: +document.getElementById('inputY1Ebitda').value||0,
      ocf: +document.getElementById('inputY1Ocf').value||0
    },
    y2:{
      revenue: +document.getElementById('inputY2Revenue').value||0,
      netProfit: +document.getElementById('inputY2NetProfit').value||0,
      ebitda: +document.getElementById('inputY2Ebitda').value||0,
      ocf: +document.getElementById('inputY2Ocf').value||0
    },
    y3:{
      revenue: +document.getElementById('inputY3Revenue').value||0,
      netProfit: +document.getElementById('inputY3NetProfit').value||0,
      ebitda: +document.getElementById('inputY3Ebitda').value||0,
      ocf: +document.getElementById('inputY3Ocf').value||0
    },
  };

  const formatExact = (v) => v === null || v === undefined || isNaN(v) ? '₹0.00 Cr' : '₹' + Number(v).toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' Cr';
  const formatPercent = (v) => v.toFixed(1) + '%';
  
  // Update key indicators
  document.getElementById('finRevY3').textContent = formatExact(D.y3.revenue);
  const revGrowth23 = ((D.y3.revenue - D.y2.revenue) / (D.y2.revenue || 1)) * 100;
  const revGrowthEl = document.getElementById('finRevGrowth');
  revGrowthEl.className = 'kpi-st ' + (revGrowth23 >= 0 ? 'ok' : 'bad');
  revGrowthEl.innerHTML = `<i class="fas fa-arrow-${revGrowth23 >= 0 ? 'up' : 'down'}"></i> ${Math.abs(revGrowth23).toFixed(1)}% YoY`;

  const npmY3 = (D.y3.netProfit / (D.y3.revenue || 1)) * 100;
  const npmY2 = (D.y2.netProfit / (D.y2.revenue || 1)) * 100;
  const npmY1 = (D.y1.netProfit / (D.y1.revenue || 1)) * 100;
  const npmAvg = (npmY1 + npmY2 + npmY3) / 3;
  document.getElementById('finNPMY3').textContent = formatPercent(npmY3);
  document.getElementById('finNPMAvg').innerHTML = `<i class="fas fa-chart-line"></i> ${npmAvg.toFixed(1)}% Avg`;

  const currentRatio = D.currentAssets / (D.currentLiabilities || 1);
  document.getElementById('finCRY3').textContent = currentRatio.toFixed(2) + 'x';
  const crStatusEl = document.getElementById('finCRStatus');
  crStatusEl.className = 'kpi-st ' + (currentRatio >= 1.5 ? 'ok' : currentRatio >= 1.0 ? 'warn' : 'bad');
  crStatusEl.innerHTML = `<i class="fas fa-${currentRatio >= 1.5 ? 'check-circle' : currentRatio >= 1.0 ? 'exclamation-circle' : 'times-circle'}"></i> ${currentRatio >= 1.5 ? 'Good Liquidity' : currentRatio >= 1.0 ? 'Adequate' : 'Weak Liquidity'}`;

  const ocfY1 = D.y1.ocf;
  const ocfY2 = D.y2.ocf;
  const ocfY3 = D.y3.ocf;
  
  let cfTrend = 'Stable';
  let cfClass = 'ok';
  let cfIcon = 'arrow-trend-up';
  let cfDesc = '';
  
  if (ocfY3 > ocfY2 && ocfY2 > ocfY1) {
    cfTrend = 'Improving';
    cfClass = 'ok';
    cfIcon = 'arrow-trend-up';
    cfDesc = 'Operating Cash Flow shows a consistent year-over-year increase. This is an excellent indicator of working capital efficiency, strong collections, and high quality of earnings.';
  } else if (ocfY3 < ocfY2 && ocfY2 < ocfY1) {
    cfTrend = 'Declining';
    cfClass = 'bad';
    cfIcon = 'arrow-trend-down';
    cfDesc = 'Operating Cash Flow is in a persistent downward trend. This flags potential liquidity stress, growing receivables, or operational inefficiencies, despite reported accounting profits.';
  } else if (ocfY3 > ocfY2 && ocfY2 < ocfY1) {
    cfTrend = 'Recovering';
    cfClass = 'warn';
    cfIcon = 'arrow-up-right-dots';
    cfDesc = 'Operating Cash Flow dipped in Year 2 but recovered strongly in Year 3. This indicates a positive turnaround in operational cash generation, though past volatility suggests caution.';
  } else if (ocfY3 < ocfY2 && ocfY2 > ocfY1) {
    cfTrend = 'Softening';
    cfClass = 'warn';
    cfIcon = 'chart-line-down';
    cfDesc = 'Operating Cash Flow peaked in Year 2 and softened in Year 3. Close monitoring is recommended to check if this is due to inventory buildup or delayed client payments.';
  } else {
    cfTrend = 'Volatile';
    cfClass = 'warn';
    cfIcon = 'wave-square';
    cfDesc = 'Operating Cash Flow exhibits high volatility over the 3-year period. Unpredictable operational cash flow complicates debt service planning and flags credit risk.';
  }
  
  document.getElementById('finCFTrendVal').textContent = formatExact(ocfY3);
  const cfTrendBadge = document.getElementById('finCFTrendBadge');
  cfTrendBadge.className = 'kpi-st ' + cfClass;
  cfTrendBadge.innerHTML = `<i class="fas fa-${cfIcon}"></i> ${cfTrend}`;

  // Update Tables
  // P&L Table
  document.getElementById('tdPlRevY1').textContent = formatExact(D.y1.revenue);
  document.getElementById('tdPlRevY2').textContent = formatExact(D.y2.revenue);
  document.getElementById('tdPlRevY3').textContent = formatExact(D.y3.revenue);
  document.getElementById('tdPlRevYoY').textContent = revGrowth23.toFixed(1) + '%';
  document.getElementById('tdPlRevYoY').className = 'num ' + (revGrowth23 >= 0 ? 'l-ok' : 'l-err');

  document.getElementById('tdPlEbitdaY1').textContent = formatExact(D.y1.ebitda);
  document.getElementById('tdPlEbitdaY2').textContent = formatExact(D.y2.ebitda);
  document.getElementById('tdPlEbitdaY3').textContent = formatExact(D.y3.ebitda);
  const ebitdaGrowth23 = ((D.y3.ebitda - D.y2.ebitda) / (D.y2.ebitda || 1)) * 100;
  document.getElementById('tdPlEbitdaYoY').textContent = ebitdaGrowth23.toFixed(1) + '%';
  document.getElementById('tdPlEbitdaYoY').className = 'num ' + (ebitdaGrowth23 >= 0 ? 'l-ok' : 'l-err');

  const ebitdaMarY1 = (D.y1.ebitda / (D.y1.revenue || 1)) * 100;
  const ebitdaMarY2 = (D.y2.ebitda / (D.y2.revenue || 1)) * 100;
  const ebitdaMarY3 = (D.y3.ebitda / (D.y3.revenue || 1)) * 100;
  document.getElementById('tdPlEbitdaMarY1').textContent = formatPercent(ebitdaMarY1);
  document.getElementById('tdPlEbitdaMarY2').textContent = formatPercent(ebitdaMarY2);
  document.getElementById('tdPlEbitdaMarY3').textContent = formatPercent(ebitdaMarY3);
  const ebitdaMarDiff = ebitdaMarY3 - ebitdaMarY2;
  document.getElementById('tdPlEbitdaMarDiff').textContent = (ebitdaMarDiff >= 0 ? '+' : '') + ebitdaMarDiff.toFixed(1) + ' pp';
  document.getElementById('tdPlEbitdaMarDiff').className = 'num ' + (ebitdaMarDiff >= 0 ? 'l-ok' : 'l-err');

  document.getElementById('tdPlNpY1').textContent = formatExact(D.y1.netProfit);
  document.getElementById('tdPlNpY2').textContent = formatExact(D.y2.netProfit);
  document.getElementById('tdPlNpY3').textContent = formatExact(D.y3.netProfit);
  const npGrowth23 = ((D.y3.netProfit - D.y2.netProfit) / (D.y2.netProfit || 1)) * 100;
  document.getElementById('tdPlNpYoY').textContent = npGrowth23.toFixed(1) + '%';
  document.getElementById('tdPlNpYoY').className = 'num ' + (npGrowth23 >= 0 ? 'l-ok' : 'l-err');

  document.getElementById('tdPlNpMarY1').textContent = formatPercent(npmY1);
  document.getElementById('tdPlNpMarY2').textContent = formatPercent(npmY2);
  document.getElementById('tdPlNpMarY3').textContent = formatPercent(npmY3);
  const npmDiff = npmY3 - npmY2;
  document.getElementById('tdPlNpMarDiff').textContent = (npmDiff >= 0 ? '+' : '') + npmDiff.toFixed(1) + ' pp';
  document.getElementById('tdPlNpMarDiff').className = 'num ' + (npmDiff >= 0 ? 'l-ok' : 'l-err');

  // P&L AI Text Summary
  const plSummaryText = document.getElementById('plSummaryText');
  plSummaryText.innerHTML = `
    <p>• <strong>YoY Revenue Growth:</strong> Revenue grew by <strong>${revGrowth23.toFixed(1)}%</strong> in the latest fiscal year, moving from ${formatExact(D.y2.revenue)} to ${formatExact(D.y3.revenue)}.</p>
    <p>• <strong>Profitability Margin:</strong> Latest Net Margin stands at <strong>${npmY3.toFixed(1)}%</strong>. Operating EBITDA Margin of <strong>${ebitdaMarY3.toFixed(1)}%</strong> represents a <strong>${(ebitdaMarDiff >= 0 ? '+' : '') + ebitdaMarDiff.toFixed(1)} percentage point</strong> shift compared to last year.</p>
    <p>• <strong>Analysis:</strong> ${npmY3 >= 12 ? 'Excellent operational margins with highly profitable operations.' : npmY3 >= 6 ? 'Healthy operational margins within acceptable sector ranges.' : 'Narrow profitability margin; operating costs should be monitored.'}</p>
  `;

  // Balance Sheet Table
  const totalAssets = D.currentAssets + D.fixedAssets;
  const totalLiabEquity = D.currentLiabilities + D.longTermDebt + D.equity;
  
  document.getElementById('tdBsCA').textContent = formatExact(D.currentAssets);
  document.getElementById('tdBsCAPct').textContent = formatPercent((D.currentAssets / (totalAssets || 1)) * 100);
  
  document.getElementById('tdBsFA').textContent = formatExact(D.fixedAssets);
  document.getElementById('tdBsFAPct').textContent = formatPercent((D.fixedAssets / (totalAssets || 1)) * 100);
  
  document.getElementById('tdBsTotalAssets').textContent = formatExact(totalAssets);
  
  document.getElementById('tdBsCL').textContent = formatExact(D.currentLiabilities);
  document.getElementById('tdBsCLPct').textContent = formatPercent((D.currentLiabilities / (totalLiabEquity || 1)) * 100);
  
  document.getElementById('tdBsLD').textContent = formatExact(D.longTermDebt);
  document.getElementById('tdBsLDPct').textContent = formatPercent((D.longTermDebt / (totalLiabEquity || 1)) * 100);
  
  document.getElementById('tdBsEQ').textContent = formatExact(D.equity);
  document.getElementById('tdBsEQPct').textContent = formatPercent((D.equity / (totalLiabEquity || 1)) * 100);
  
  document.getElementById('tdBsTotalLiabEquity').textContent = formatExact(totalLiabEquity);

  // Balance Sheet AI Summary
  const bsSummaryText = document.getElementById('bsSummaryText');
  const deRatio = D.longTermDebt / (D.equity || 1);
  bsSummaryText.innerHTML = `
    <p>• <strong>Asset Allocation:</strong> Current Assets represent <strong>${((D.currentAssets / (totalAssets || 1)) * 100).toFixed(1)}%</strong> of total asset size, indicating ${D.currentAssets > D.fixedAssets ? 'high asset liquidity' : 'a capital-intensive business model'}.</p>
    <p>• <strong>Debt Profile:</strong> Debt to Equity ratio stands at <strong>${deRatio.toFixed(2)}x</strong>. Long term leverage accounts for <strong>${((D.longTermDebt / (totalLiabEquity || 1)) * 100).toFixed(1)}%</strong> of the capital structure.</p>
    <p>• <strong>Analysis:</strong> ${deRatio <= 1.0 ? 'Capital structure is conservative with moderate debt reliance.' : deRatio <= 1.5 ? 'Moderate debt usage; cash flows are likely sufficient to support leverage.' : 'Higher debt utilization. High debt repayment pressure may exist.'}</p>
  `;

  // Cash Flow Table
  document.getElementById('tdCfOcfY1').textContent = formatExact(D.y1.ocf);
  document.getElementById('tdCfOcfY2').textContent = formatExact(D.y2.ocf);
  document.getElementById('tdCfOcfY3').textContent = formatExact(D.y3.ocf);
  const ocfGrowth23 = ((D.y3.ocf - D.y2.ocf) / (D.y2.ocf || 1)) * 100;
  document.getElementById('tdCfOcfYoY').textContent = ocfGrowth23.toFixed(1) + '%';
  document.getElementById('tdCfOcfYoY').className = 'num ' + (ocfGrowth23 >= 0 ? 'l-ok' : 'l-err');

  const ocfRevY1 = (D.y1.ocf / (D.y1.revenue || 1)) * 100;
  const ocfRevY2 = (D.y2.ocf / (D.y2.revenue || 1)) * 100;
  const ocfRevY3 = (D.y3.ocf / (D.y3.revenue || 1)) * 100;
  document.getElementById('tdCfOcfRevY1').textContent = formatPercent(ocfRevY1);
  document.getElementById('tdCfOcfRevY2').textContent = formatPercent(ocfRevY2);
  document.getElementById('tdCfOcfRevY3').textContent = formatPercent(ocfRevY3);
  const ocfRevDiff = ocfRevY3 - ocfRevY2;
  document.getElementById('tdCfOcfRevYoY').textContent = (ocfRevDiff >= 0 ? '+' : '') + ocfRevDiff.toFixed(1) + ' pp';
  document.getElementById('tdCfOcfRevYoY').className = 'num ' + (ocfRevDiff >= 0 ? 'l-ok' : 'l-err');

  const ocfEbitdaY1 = (D.y1.ocf / (D.y1.ebitda || 1)) * 100;
  const ocfEbitdaY2 = (D.y2.ocf / (D.y2.ebitda || 1)) * 100;
  const ocfEbitdaY3 = (D.y3.ocf / (D.y3.ebitda || 1)) * 100;
  document.getElementById('tdCfOcfEbitdaY1').textContent = formatPercent(ocfEbitdaY1);
  document.getElementById('tdCfOcfEbitdaY2').textContent = formatPercent(ocfEbitdaY2);
  document.getElementById('tdCfOcfEbitdaY3').textContent = formatPercent(ocfEbitdaY3);
  const ocfEbitdaDiff = ocfEbitdaY3 - ocfEbitdaY2;
  document.getElementById('tdCfOcfEbitdaYoY').textContent = (ocfEbitdaDiff >= 0 ? '+' : '') + ocfEbitdaDiff.toFixed(1) + ' pp';
  document.getElementById('tdCfOcfEbitdaYoY').className = 'num ' + (ocfEbitdaDiff >= 0 ? 'l-ok' : 'l-err');

  // Trend Card Styling
  const tcEl = document.getElementById('cfTrendCard');
  tcEl.className = 'trend-card ' + (cfClass === 'ok' ? 'improving' : cfClass === 'bad' ? 'declining' : 'warning');
  document.getElementById('cfTrendTitle').textContent = `Cash Flow is ${cfTrend}`;
  const iconBg = cfClass === 'ok' ? 'var(--ok-s)' : cfClass === 'bad' ? 'var(--err-s)' : 'var(--warn-s)';
  const iconColor = cfClass === 'ok' ? 'var(--ok)' : cfClass === 'bad' ? 'var(--err)' : 'var(--warn)';
  document.getElementById('cfTrendIcon').style.background = iconBg;
  document.getElementById('cfTrendIcon').style.color = iconColor;
  document.getElementById('cfTrendIcon').innerHTML = `<i class="fas fa-${cfIcon}"></i>`;
  document.getElementById('cfTrendDesc').innerHTML = cfDesc + ` Operating cash flow grew/declined by <strong>${ocfGrowth23.toFixed(1)}%</strong> over the past year. The OCF-to-Revenue ratio of <strong>${ocfRevY3.toFixed(1)}%</strong> indicates that for every ₹100 of turnover, the company converts ₹${(D.y3.ocf / (D.y3.revenue || 1) * 100).toFixed(0)} into operational cash flow.`;

  // Render P&L Trend Chart (Net Profit & EBITDA Margin Trend Line)
  if (charts.plTrend) charts.plTrend.destroy();
  const CFG_AXES = {
    x:{ticks:{color:'#94A3B8'},grid:{color:'rgba(255,255,255,.04)'}},
    y:{ticks:{color:'#94A3B8'},grid:{color:'rgba(255,255,255,.04)'}}
  };
  
  charts.plTrend = new Chart(document.getElementById('chPlTrend'), {
    type: 'line',
    data: {
      labels: ['Year 1', 'Year 2', 'Year 3'],
      datasets: [
        {
          label: 'Net Profit (₹ Cr)',
          data: [D.y1.netProfit, D.y2.netProfit, D.y3.netProfit],
          borderColor: 'var(--ok)',
          backgroundColor: 'transparent',
          borderWidth: 3,
          tension: 0.2,
          yAxisID: 'yNetProfit',
          pointBackgroundColor: 'var(--ok)',
          pointHoverRadius: 7
        },
        {
          label: 'EBITDA Margin (%)',
          data: [ebitdaMarY1, ebitdaMarY2, ebitdaMarY3],
          borderColor: 'var(--p1)',
          backgroundColor: 'transparent',
          borderWidth: 3,
          tension: 0.2,
          yAxisID: 'yEbitdaMargin',
          pointBackgroundColor: 'var(--p1)',
          pointHoverRadius: 7
        }
      ]
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      plugins: {
        legend: { display: true, labels: { color: '#94A3B8', boxWidth: 12 } }
      },
      scales: {
        x: {
          ticks: { color: '#94A3B8' },
          grid: { color: 'rgba(255,255,255,.04)' }
        },
        yNetProfit: {
          type: 'linear',
          position: 'left',
          ticks: {
            color: '#94A3B8',
            callback: v => '₹' + v + ' Cr'
          },
          grid: { color: 'rgba(255,255,255,.04)' }
        },
        yEbitdaMargin: {
          type: 'linear',
          position: 'right',
          ticks: {
            color: '#94A3B8',
            callback: v => v.toFixed(1) + '%'
          },
          grid: { drawOnChartArea: false }
        }
      }
    }
  });

  // Render Cash Flow Trend Chart
  if (charts.cfTrend) charts.cfTrend.destroy();
  charts.cfTrend = new Chart(document.getElementById('chCfTrend'), {
    type: 'line',
    data: {
      labels: ['Year 1', 'Year 2', 'Year 3'],
      datasets: [{
        label: 'Operating Cash Flow (₹ Cr)',
        data: [ocfY1, ocfY2, ocfY3],
        borderColor: iconColor,
        backgroundColor: 'rgba(99, 102, 241, 0.05)',
        borderWidth: 3,
        tension: 0.2,
        fill: true,
        pointBackgroundColor: iconColor,
        pointHoverRadius: 7
      }]
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      plugins: {
        legend: { display: false }
      },
      scales: {
        ...CFG_AXES,
        y: {
          ...CFG_AXES.y,
          ticks: {
            ...CFG_AXES.y.ticks,
            callback: v => '₹' + v + ' Cr'
          }
        }
      }
    }
  });

  goPage(4);
}

/* ═══════════════════════════════════════
   RATIOS COMPUTATION & VISUALIZATION (NEW)
   ═══════════════════════════════════════ */
function goRatios() {
  const D = {
    cibil: +document.getElementById('inputCibil').value||0,
    proposedLoan: +document.getElementById('inputProposedLoan').value||0,
    proposedEMI: +document.getElementById('inputProposedEMI').value||0,
    monthlyIncome: +document.getElementById('inputMonthlyIncome').value||0,
    existingEMI: +document.getElementById('inputExistingEMI').value||0,
    currentAssets: +document.getElementById('inputCurrentAssets').value||0,
    inventory: +document.getElementById('inputInventory').value||0,
    fixedAssets: +document.getElementById('inputFixedAssets').value||0,
    currentLiabilities: +document.getElementById('inputCurrentLiabilities').value||0,
    longTermDebt: +document.getElementById('inputLongTermDebt').value||0,
    equity: +document.getElementById('inputEquity').value||0,
    y1:{
      revenue: +document.getElementById('inputY1Revenue').value||0,
      netProfit: +document.getElementById('inputY1NetProfit').value||0,
      ebitda: +document.getElementById('inputY1Ebitda').value||0,
      ocf: +document.getElementById('inputY1Ocf').value||0
    },
    y2:{
      revenue: +document.getElementById('inputY2Revenue').value||0,
      netProfit: +document.getElementById('inputY2NetProfit').value||0,
      ebitda: +document.getElementById('inputY2Ebitda').value||0,
      ocf: +document.getElementById('inputY2Ocf').value||0
    },
    y3:{
      revenue: +document.getElementById('inputY3Revenue').value||0,
      netProfit: +document.getElementById('inputY3NetProfit').value||0,
      ebitda: +document.getElementById('inputY3Ebitda').value||0,
      ocf: +document.getElementById('inputY3Ocf').value||0
    },
  };

  const formatExact = (v) => v === null || v === undefined || isNaN(v) ? '₹0.00 Cr' : '₹' + Number(v).toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' Cr';
  const formatPercent = (v) => isNaN(v) || !isFinite(v) ? '0.0%' : v.toFixed(1) + '%';
  const formatRatio = (v) => isNaN(v) || !isFinite(v) ? '0.00x' : v.toFixed(2) + 'x';

  // Populate Year Labels
  const yrList = S.extractedData?.yearsList || [2022, 2023, 2024];
  const y1Name = yrList[0] ? 'FY ' + yrList[0] : 'Year 1';
  const y2Name = yrList[1] ? 'FY ' + yrList[1] : 'Year 2';
  const y3Name = yrList[2] ? 'FY ' + yrList[2] : 'Year 3 (Latest)';
  
  document.getElementById('ratY1Lbl').textContent = y1Name;
  document.getElementById('ratY2Lbl').textContent = y2Name;
  document.getElementById('ratY3Lbl').textContent = y3Name;

  // 1. Profitability Ratios
  const npmY1 = (D.y1.netProfit / (D.y1.revenue || 1)) * 100;
  const npmY2 = (D.y2.netProfit / (D.y2.revenue || 1)) * 100;
  const npmY3 = (D.y3.netProfit / (D.y3.revenue || 1)) * 100;

  const ebitdaMarY1 = (D.y1.ebitda / (D.y1.revenue || 1)) * 100;
  const ebitdaMarY2 = (D.y2.ebitda / (D.y2.revenue || 1)) * 100;
  const ebitdaMarY3 = (D.y3.ebitda / (D.y3.revenue || 1)) * 100;

  const opMarY1 = ((D.y1.ebitda * 0.85) / (D.y1.revenue || 1)) * 100;
  const opMarY2 = ((D.y2.ebitda * 0.85) / (D.y2.revenue || 1)) * 100;
  const opMarY3 = ((D.y3.ebitda * 0.85) / (D.y3.revenue || 1)) * 100;

  document.getElementById('tdRatNpmY1').textContent = formatPercent(npmY1);
  document.getElementById('tdRatNpmY2').textContent = formatPercent(npmY2);
  document.getElementById('tdRatNpmY3').textContent = formatPercent(npmY3);
  document.getElementById('tdRatNpmY3').className = 'num ' + (npmY3 >= 15 ? 'l-ok' : npmY3 >= 8 ? 'l-warn' : 'l-err');

  document.getElementById('tdRatEbitdaMarY1').textContent = formatPercent(ebitdaMarY1);
  document.getElementById('tdRatEbitdaMarY2').textContent = formatPercent(ebitdaMarY2);
  document.getElementById('tdRatEbitdaMarY3').textContent = formatPercent(ebitdaMarY3);
  document.getElementById('tdRatEbitdaMarY3').className = 'num ' + (ebitdaMarY3 >= 20 ? 'l-ok' : ebitdaMarY3 >= 12 ? 'l-warn' : 'l-err');

  document.getElementById('tdRatOpMarY1').textContent = formatPercent(opMarY1);
  document.getElementById('tdRatOpMarY2').textContent = formatPercent(opMarY2);
  document.getElementById('tdRatOpMarY3').textContent = formatPercent(opMarY3);
  document.getElementById('tdRatOpMarY3').className = 'num ' + (opMarY3 >= 15 ? 'l-ok' : opMarY3 >= 8 ? 'l-warn' : 'l-err');

  // 2. Liquidity Ratios
  const currentRatio = D.currentAssets / (D.currentLiabilities || 1);
  const quickRatio = (D.currentAssets - D.inventory) / (D.currentLiabilities || 1);
  document.getElementById('tdRatCRY3').textContent = formatRatio(currentRatio);
  document.getElementById('tdRatCRY3').className = 'num ' + (currentRatio >= 1.5 ? 'l-ok' : currentRatio >= 1.2 ? 'l-warn' : 'l-err');
  document.getElementById('tdRatQRY3').textContent = formatRatio(quickRatio);
  document.getElementById('tdRatQRY3').className = 'num ' + (quickRatio >= 1.0 ? 'l-ok' : quickRatio >= 0.8 ? 'l-warn' : 'l-err');

  // 3. Leverage Ratios
  const totalDebt = D.currentLiabilities + D.longTermDebt;
  const deRatio = totalDebt / (D.equity || 1);
  const totalAssets = D.currentAssets + D.fixedAssets;
  const debtRatio = (totalDebt / (totalAssets || 1)) * 100;
  document.getElementById('tdRatDEY3').textContent = formatRatio(deRatio);
  document.getElementById('tdRatDEY3').className = 'num ' + (deRatio <= 1.0 ? 'l-ok' : deRatio <= 1.5 ? 'l-warn' : 'l-err');
  document.getElementById('tdRatDRY3').textContent = formatPercent(debtRatio);
  document.getElementById('tdRatDRY3').className = 'num ' + (debtRatio <= 50 ? 'l-ok' : debtRatio <= 65 ? 'l-warn' : 'l-err');

  // 4. Efficiency Ratios
  const assetTurnover = D.y3.revenue / (totalAssets || 1);
  document.getElementById('tdRatATY3').textContent = formatRatio(assetTurnover);
  document.getElementById('tdRatATY3').className = 'num ' + (assetTurnover >= 1.2 ? 'l-ok' : assetTurnover >= 0.8 ? 'l-warn' : 'l-err');

  // 5. Growth Ratios
  const revGrowthY2 = ((D.y2.revenue - D.y1.revenue) / (D.y1.revenue || 1)) * 100;
  const revGrowthY3 = ((D.y3.revenue - D.y2.revenue) / (D.y2.revenue || 1)) * 100;
  const profitGrowthY2 = ((D.y2.netProfit - D.y1.netProfit) / (D.y1.netProfit || 1)) * 100;
  const profitGrowthY3 = ((D.y3.netProfit - D.y2.netProfit) / (D.y2.netProfit || 1)) * 100;

  document.getElementById('tdRatRevG2').textContent = formatPercent(revGrowthY2);
  document.getElementById('tdRatRevG2').className = 'num ' + (revGrowthY2 >= 0 ? 'l-ok' : 'l-err');
  document.getElementById('tdRatRevG3').textContent = formatPercent(revGrowthY3);
  document.getElementById('tdRatRevG3').className = 'num ' + (revGrowthY3 >= 0 ? 'l-ok' : 'l-err');

  document.getElementById('tdRatNPGB2').textContent = formatPercent(profitGrowthY2);
  document.getElementById('tdRatNPGB2').className = 'num ' + (profitGrowthY2 >= 0 ? 'l-ok' : 'l-err');
  document.getElementById('tdRatNPGB3').textContent = formatPercent(profitGrowthY3);
  document.getElementById('tdRatNPGB3').className = 'num ' + (profitGrowthY3 >= 0 ? 'l-ok' : 'l-err');

  // AI Summary Card
  const ratiosSummary = document.getElementById('ratiosSummaryText');
  ratiosSummary.innerHTML = `
    <p>• <strong>Profitability Health:</strong> Net Profit Margin moved from <strong>${formatPercent(npmY2)}</strong> to <strong>${formatPercent(npmY3)}</strong>. The Operating Margin of <strong>${formatPercent(opMarY3)}</strong> indicates stable operating efficiency.</p>
    <p>• <strong>Liquidity Coverage:</strong> Current Ratio is <strong>${formatRatio(currentRatio)}</strong>. Taking out inventory (₹${(D.inventory).toLocaleString('en-IN', {minimumFractionDigits:2, maximumFractionDigits:2})} Cr), the Quick Ratio stands at <strong>${formatRatio(quickRatio)}</strong>, indicating ${quickRatio >= 1.0 ? 'strong near-term liquidity cover' : 'possible working capital tightness'}.</p>
    <p>• <strong>Leverage Exposure:</strong> Debt-to-Equity is <strong>${formatRatio(deRatio)}</strong>, while the Debt Ratio is <strong>${formatPercent(debtRatio)}</strong> of total assets.</p>
  `;

  // Render Ratios Trend Chart
  if (charts.ratiosTrend) charts.ratiosTrend.destroy();
  charts.ratiosTrend = new Chart(document.getElementById('chRatiosTrend'), {
    type: 'line',
    data: {
      labels: [y1Name, y2Name, y3Name],
      datasets: [
        {
          label: 'Net Margin (%)',
          data: [npmY1, npmY2, npmY3],
          borderColor: 'var(--ok)',
          backgroundColor: 'transparent',
          borderWidth: 3,
          tension: 0.15,
          pointBackgroundColor: 'var(--ok)'
        },
        {
          label: 'EBITDA Margin (%)',
          data: [ebitdaMarY1, ebitdaMarY2, ebitdaMarY3],
          borderColor: 'var(--p1)',
          backgroundColor: 'transparent',
          borderWidth: 3,
          tension: 0.15,
          pointBackgroundColor: 'var(--p1)'
        },
        {
          label: 'Operating Margin (%)',
          data: [opMarY1, opMarY2, opMarY3],
          borderColor: 'var(--p2)',
          backgroundColor: 'transparent',
          borderWidth: 3,
          tension: 0.15,
          pointBackgroundColor: 'var(--p2)'
        }
      ]
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      plugins: {
        legend: { display: true, labels: { color: '#94A3B8', boxWidth: 12 } }
      },
      scales: {
        x: { ticks: { color: '#94A3B8' }, grid: { color: 'rgba(255,255,255,.04)' } },
        y: { ticks: { color: '#94A3B8', callback: v => v.toFixed(0) + '%' }, grid: { color: 'rgba(255,255,255,.04)' } }
      }
    }
  });

  goPage(5);
}
</script>
</body>
</html>
